<style>
  /* ═══════════════════════════════════════════
   SECTION INTRO
  ═══════════════════════════════════════════ */
  .si-coll-section-intro {
    text-align: center;
    padding: 56px 40px 32px;
    position: relative;
    z-index: 2;
    background: #faf6ed;
  }
  .si-coll-section-eyebrow {
    font-family: var(--si-sans);
    font-size: 10px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #b8924a;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-bottom: 14px;
  }
  .si-coll-section-eyebrow::before,
  .si-coll-section-eyebrow::after {
    content: '';
    display: inline-block;
    width: 28px;
    height: 1px;
    background: #b8924a;
    opacity: 0.5;
  }
  .si-coll-section-title {
    font-family: var(--si-serif);
    font-size: clamp(30px, 4vw, 48px);
    font-weight: 400;
    color: #4a0f1c;
    line-height: 1.1;
    margin: 0;
  }
  .si-coll-section-title em {
    font-style: italic;
    color: #6b1a2a;
  }

  /* ═══════════════════════════════════════════
   COLLECTION GRID
  ═══════════════════════════════════════════ */
  .si-coll-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem 48px;
    position: relative;
    z-index: 2;
    background: #faf6ed;
  }

  /* ─── COLLECTION CARD ─── */
  .si-coll-card {
    position: relative;
    display: block;
    text-decoration: none;
    color: inherit;
    overflow: hidden;
  }

  .si-coll-card-inner {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    cursor: pointer;
  }

  /* collection image */
  .si-coll-card-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .si-coll-card:hover .si-coll-card-img {
    transform: scale(1.06);
  }

  /* gradient fallback when no image */
  .si-coll-card-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .si-coll-card-fallback--1 {
    background: linear-gradient(135deg, #f0e4d8, #e8d0c0);
  }
  .si-coll-card-fallback--2 {
    background: linear-gradient(135deg, #e8d8d0, #d8c0b0);
  }
  .si-coll-card-fallback--3 {
    background: linear-gradient(135deg, #e1e7f0, #d0dce8);
  }
  .si-coll-card-fallback--4 {
    background: linear-gradient(135deg, #e0ebd9, #c8ddb8);
  }

  .si-coll-card-fallback svg {
    width: 40px;
    height: 40px;
    opacity: 0.2;
  }

  /* bottom overlay gradient */
  .si-coll-card-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(
      to top,
      rgba(30, 14, 20, 0.88) 0%,
      rgba(30, 14, 20, 0.55) 35%,
      rgba(30, 14, 20, 0.15) 60%,
      transparent 80%
    );
    transition: opacity 0.4s;
  }
  .si-coll-card:hover .si-coll-card-overlay {
    opacity: 0.9;
  }

  /* text content on image */
  .si-coll-card-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 3;
    padding: 24px 22px;
    background: linear-gradient(to top, rgba(30, 14, 20, 0.7) 0%, rgba(30, 14, 20, 0.4) 60%, transparent 100%);
  }

  .si-coll-card-count {
    font-family: var(--si-sans);
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #e8c868;
    font-weight: 600;
    margin-bottom: 8px;
  }

  .si-coll-card-name {
    font-family: var(--si-serif);
    font-size: clamp(16px, 1.8vw, 20px);
    font-weight: 400;
    color: #f5eed8 !important;
    line-height: 1.25;
    margin: 0 0 5px;
  }

  .si-coll-card-desc {
    font-family: var(--si-sans);
    font-size: 12px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.9);
    font-weight: 300;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .si-coll-card-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--si-sans);
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 600;
    color: #e8c868;
    opacity: 0;
    transform: translateY(8px);
    transition: all 0.35s ease;
  }
  .si-coll-card:hover .si-coll-card-cta {
    opacity: 1;
    transform: translateY(0);
  }
  .si-coll-card-cta svg {
    width: 11px;
    height: 11px;
  }

  .si-coll-card-count {
    font-family: var(--si-sans);
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #d4b870;
    font-weight: 600;
    margin-bottom: 8px;
  }

  .si-coll-card-name {
    font-family: var(--si-serif);
    font-size: clamp(16px, 1.8vw, 20px);
    font-weight: 400;
    color: #faf6ed;
    line-height: 1.25;
    margin: 0 0 5px;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.4), 0 2px 12px rgba(0, 0, 0, 0.25);
  }

  .si-coll-card-desc {
    font-family: var(--si-sans);
    font-size: 12px;
    line-height: 1.6;
    color: rgba(250, 246, 237, 0.85);
    font-weight: 300;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.3);
  }

  .si-coll-card-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--si-sans);
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 600;
    color: #faf6ed;
    opacity: 0;
    transform: translateY(8px);
    transition: all 0.35s ease;
  }
  .si-coll-card:hover .si-coll-card-cta {
    opacity: 1;
    transform: translateY(0);
  }
  .si-coll-card-cta svg {
    width: 11px;
    height: 11px;
  }

  /* disabled state */
  .si-coll-card--disabled {
    cursor: default;
  }
  .si-coll-card--disabled .si-coll-card-inner {
    cursor: default;
  }
  .si-coll-card--disabled:hover .si-coll-card-img {
    transform: none;
  }
  .si-coll-card--disabled .si-coll-card-cta {
    display: none;
  }

  /* ═══════════════════════════════════════════
   SCROLL REVEAL
  ═══════════════════════════════════════════ */
  .si-coll-reveal {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.6s ease,
      transform 0.6s ease;
  }
  .si-coll-reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ═══════════════════════════════════════════
   RESPONSIVE
  ═══════════════════════════════════════════ */
  @media screen and (max-width: 1100px) {
    .si-coll-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media screen and (max-width: 749px) {
    .si-coll-section-intro {
      padding: 40px 24px 24px;
    }
    .si-coll-grid {
      grid-template-columns: 1fr;
      gap: 12px;
      padding: 0 1rem 48px;
    }
    .si-coll-card-inner {
      aspect-ratio: 3 / 2;
    }
    .si-coll-card-content {
      padding: 16px;
    }
  }
</style>

<div class='si-coll-section-intro si-coll-reveal'>
  <div class='si-coll-section-eyebrow'>Explore</div>
  <h2 class='si-coll-section-title'>Shop by <em>Category</em></h2>
</div>

<div class='si-coll-grid'>
  {%- if section.settings.dynamic_collections -%}
    {%- assign excluded_handles = section.settings.excluded_handles | split: ',' -%}
    {%- assign rendered_index = 0 -%}
    {%- for tile_collection in collections -%}
      {%- liquid
        assign handle_stripped = tile_collection.handle | strip
        assign should_exclude = false
        for excl in excluded_handles
          assign excl_stripped = excl | strip
          if excl_stripped == handle_stripped
            assign should_exclude = true
          endif
        endfor
      -%}
      {%- if should_exclude -%}
        {%- continue -%}
      {%- endif -%}

      {%- liquid
        assign has_products = false
        if tile_collection.all_products_count > 0
          assign has_products = true
        endif

        assign tile_url = tile_collection.url
        assign tile_title = tile_collection.title
        assign tile_desc = tile_collection.description
        assign tile_count = tile_collection.all_products_count

        assign tile_image = tile_collection.image
        unless tile_image
          if tile_collection.products.size > 0
            assign tile_image = tile_collection.products.first.featured_image
          endif
        endunless

        assign bg_index = rendered_index | modulo: 4 | plus: 1
        assign rendered_index = rendered_index | plus: 1
      -%}

      {%- if has_products -%}
        <a
          href='{{ tile_url }}'
          class='si-coll-card si-coll-reveal'
          style='transition-delay:{{ rendered_index | times: 0.06 }}s;'
          {{ tile_collection.shopify_attributes }}
        >
      {%- else -%}
        <div
          class='si-coll-card si-coll-card--disabled si-coll-reveal'
          style='transition-delay:{{ rendered_index | times: 0.06 }}s;'
        >
      {%- endif -%}

      <div class='si-coll-card-inner'>
        {% if tile_image %}
          <img
            class='si-coll-card-img'
            src='{{ tile_image | image_url: width: 800 }}'
            alt='{{ tile_image.alt | default: tile_title | escape }}'
            width='600'
            height='800'
            loading='lazy'
          >
        {% else %}
          <div class='si-coll-card-fallback si-coll-card-fallback--{{ bg_index }}'>
            <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48' fill='none' stroke='#8b6a4a' stroke-width='1.5'>
              <rect x='6' y='6' width='36' height='36' rx='2'/>
              <path d='M6 34l10-10 8 8 6-6 12 12'/>
              <circle cx='16' cy='16' r='4'/>
            </svg>
          </div>
        {% endif %}
        <div class='si-coll-card-overlay'></div>
        <div class='si-coll-card-content'>
          {% if tile_count > 0 %}
            <p class='si-coll-card-count'>
              {{ tile_count }}
              {{ tile_count | pluralize: 'product', 'products' }}
            </p>
          {% endif %}
          {% if tile_title != blank %}
            <h3 class='si-coll-card-name'>{{ tile_title }}</h3>
          {% endif %}
          {% if tile_desc != blank %}
            <p class='si-coll-card-desc'>{{ tile_desc | strip_html | truncatewords: 12 }}</p>
          {% endif %}
          {%- if has_products -%}
            <span class='si-coll-card-cta'>
              Shop Now
              <svg
                xmlns='http://www.w3.org/2000/svg'
                viewBox='0 0 12 12'
                fill='none'
                stroke='currentColor'
                stroke-width='1.5'
              >
                <path d='M2.5 6h7M7 3l3 3-3 3'/>
              </svg>
            </span>
          {%- endif -%}
        </div>
      </div>

      {%- if has_products -%}
        </a>
      {%- else -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  {%- else -%}
    {% for block in section.blocks %}
      {%- liquid
        assign tile_collection = block.settings.collection
        assign has_products = false
        if tile_collection != blank and tile_collection.all_products_count > 0
          assign has_products = true
        endif

        if tile_collection != blank
          assign tile_url = tile_collection.url
          assign tile_title = block.settings.title | default: tile_collection.title
          assign tile_count = tile_collection.all_products_count

          assign tile_image = tile_collection.image
          unless tile_image
            if tile_collection.products.size > 0
              assign tile_image = tile_collection.products.first.featured_image
            endif
          endunless
        else
          assign tile_url = block.settings.link
          assign tile_title = block.settings.title
          assign tile_image = null
          assign tile_count = 0
        endif

        assign bg_index = forloop.index0 | modulo: 4 | plus: 1
      -%}

      {%- if has_products -%}
        <a
          href='{{ tile_url }}'
          class='si-coll-card si-coll-reveal'
          style='transition-delay:{{ forloop.index | times: 0.06 }}s;'
          {{ block.shopify_attributes }}
        >
      {%- else -%}
        <div
          class='si-coll-card si-coll-card--disabled si-coll-reveal'
          style='transition-delay:{{ forloop.index | times: 0.06 }}s;'
          {{ block.shopify_attributes }}
        >
      {%- endif -%}

      <div class='si-coll-card-inner'>
        {% if tile_image %}
          <img
            class='si-coll-card-img'
            src='{{ tile_image | image_url: width: 800 }}'
            alt='{{ tile_image.alt | default: tile_title | escape }}'
            width='600'
            height='800'
            loading='lazy'
          >
        {% else %}
          <div class='si-coll-card-fallback si-coll-card-fallback--{{ bg_index }}'>
            <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48' fill='none' stroke='#8b6a4a' stroke-width='1.5'>
              <rect x='6' y='6' width='36' height='36' rx='2'/>
              <path d='M6 34l10-10 8 8 6-6 12 12'/>
              <circle cx='16' cy='16' r='4'/>
            </svg>
          </div>
        {% endif %}
        <div class='si-coll-card-overlay'></div>
        <div class='si-coll-card-content'>
          {% if tile_count > 0 %}
            <p class='si-coll-card-count'>
              {{ tile_count }}
              {{ tile_count | pluralize: 'product', 'products' }}
            </p>
          {% endif %}
          {% if tile_title != blank %}
            <h3 class='si-coll-card-name'>{{ tile_title }}</h3>
          {% endif %}
          {% if block.settings.description != blank %}
            <p class='si-coll-card-desc'>{{ block.settings.description }}</p>
          {% endif %}
          {%- if has_products -%}
            <span class='si-coll-card-cta'>
              Shop Now
              <svg
                xmlns='http://www.w3.org/2000/svg'
                viewBox='0 0 12 12'
                fill='none'
                stroke='currentColor'
                stroke-width='1.5'
              >
                <path d='M2.5 6h7M7 3l3 3-3 3'/>
              </svg>
            </span>
          {%- endif -%}
        </div>
      </div>

      {%- if has_products -%}
        </a>
      {%- else -%}
        </div>
      {%- endif -%}
    {% endfor %}
  {%- endif -%}
</div>

<script>
  (function () {
    var revealEls = document.querySelectorAll('.si-coll-reveal');
    if ('IntersectionObserver' in window) {
      var observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1 },
      );
      revealEls.forEach(function (el) {
        observer.observe(el);
      });
    } else {
      revealEls.forEach(function (el) {
        el.classList.add('visible');
      });
    }
  })();
</script>

{% schema %}
{
  "name": "SI Collections",
  "settings": [
    {
      "type": "checkbox",
      "id": "dynamic_collections",
      "label": "Display all collections dynamically",
      "default": true
    },
    {
      "type": "text",
      "id": "excluded_handles",
      "label": "Excluded collection handles",
      "info": "Comma-separated list of collection handles to exclude",
      "default": "frontpage, all, clipped-in-stories, carry-your-story-key-ring"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Collection Tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "category", "label": "Category" },
        { "type": "text", "id": "title", "label": "Title override", "info": "Leave blank to use the collection title" },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        { "type": "url", "id": "link", "label": "Link (fallback if no collection chosen)" },
        { "type": "checkbox", "id": "alt_bg", "label": "Alternate background", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "SI Collections",
      "blocks": [
        {
          "type": "tile",
          "settings": {
            "category": "Mystery box",
            "title": "A Novel Encounter"
          }
        }
      ]
    }
  ]
}
{% endschema %}
