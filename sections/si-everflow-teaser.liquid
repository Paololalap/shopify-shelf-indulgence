<style>
  /* ═══════════════════════════════════════
   TOKENS
═══════════════════════════════════════ */
  :root {
    --void: #fcf9e2;
    --deep: #fdf8e2;
    --burg: #6b1a2a;
    --burg-lt: #8b2e42;
    --burg-glow: #a03050;
    --cream: #610a1e;
    --cream-dk: #3a0612;
    --parch: #f5eed8;
    --gold: #c4964e;
    --gold-lt: #ddb870;
    --gold-pale: #f2e4c0;
    --muted: #7a6870;
    --muted-lt: #a89098;

    /* four elements */
    --water: #2a6a9a;
    --water-lt: #5aaad4;
    --water-glow: rgba(42, 106, 154, 0.4);
    --fire: #c44a18;
    --fire-lt: #f07a30;
    --fire-glow: rgba(196, 74, 24, 0.4);
    --earth: #4a7a34;
    --earth-lt: #7aaa5a;
    --earth-glow: rgba(74, 122, 52, 0.38);
    --air: #8aa0c0;
    --air-lt: #c0d4ec;
    --air-glow: rgba(138, 160, 192, 0.35);
  }

  /* grain overlay on whole page */

  /* ═══════════════════════════════════════
   SCROLLBAR
═══════════════════════════════════════ */

  /* ═══════════════════════════════════════
   HERO — FULL-SCREEN CINEMATIC
═══════════════════════════════════════ */
  .hero {
    min-height: 100vh;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    padding: 100px 40px 80px;
  }

  /* layered atmospheric background */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(ellipse 100% 70% at 50% 0%, rgba(107, 26, 42, 0.05) 0%, transparent 60%),
      radial-gradient(ellipse 80% 60% at 20% 100%, rgba(42, 106, 154, 0.22) 0%, transparent 55%),
      radial-gradient(ellipse 60% 50% at 80% 90%, rgba(196, 74, 24, 0.18) 0%, transparent 50%),
      radial-gradient(ellipse 50% 40% at 10% 40%, rgba(74, 122, 52, 0.14) 0%, transparent 50%),
      radial-gradient(ellipse 40% 30% at 90% 30%, rgba(138, 160, 192, 0.12) 0%, transparent 45%), transparent;
  }

  /* animated star-field particles */
  .stars {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }
  .star {
    position: absolute;
    background: var(--gold-pale);
    border-radius: 50%;
    animation: starPulse ease-in-out infinite;
  }
  @keyframes starPulse {
    0%,
    100% {
      opacity: 0.1;
      transform: scale(1);
    }
    50% {
      opacity: 0.55;
      transform: scale(1.6);
    }
  }

  /* flowing element streams */
  .element-stream {
    position: absolute;
    pointer-events: none;
    z-index: 2;
  }

  /* WATER stream — left side */
  .stream-water {
    left: -30px;
    top: 0;
    width: 220px;
    height: 100%;
    opacity: 0.22;
  }
  /* FIRE stream — right side */
  .stream-fire {
    right: -20px;
    top: 0;
    width: 200px;
    height: 100%;
    opacity: 0.18;
  }
  /* EARTH — bottom left scattered leaves */
  .stream-earth {
    left: 5%;
    bottom: 0;
    width: 160px;
    height: 40%;
    opacity: 0.16;
  }
  /* AIR — top right mist */
  .stream-air {
    right: 5%;
    top: 0;
    width: 180px;
    height: 40%;
    opacity: 0.14;
  }

  /* floating rune particles */
  .rune-particle {
    position: absolute;
    font-family: 'Cinzel', serif;
    color: var(--gold);
    pointer-events: none;
    z-index: 3;
    animation: runeFloat ease-in-out infinite;
  }
  @keyframes runeFloat {
    0%,
    100% {
      opacity: 0;
      transform: translateY(0) rotate(0deg);
    }
    20% {
      opacity: 0.3;
    }
    80% {
      opacity: 0.2;
    }
    100% {
      opacity: 0;
      transform: translateY(-120px) rotate(15deg);
    }
  }

  /* animated water waves at very bottom of hero */
  .hero-wave {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 4;
    pointer-events: none;
  }

  /* ─── hero text ─── */
  .hero-content {
    position: relative;
    z-index: 10;
  }

  .hero-overline {
    font-family: 'Cinzel', serif;
    font-size: 9.92px;
    letter-spacing: 0.44em;
    text-transform: uppercase;
    color: var(--gold);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-bottom: 28px;
    margin-top: 0 !important;
    animation: fadeUp 0.9s ease both 0.05s;
  }
  .hero-overline::before,
  .hero-overline::after {
    content: '';
    display: inline-block;
    width: 40px;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--gold));
  }
  .hero-overline::after {
    background: linear-gradient(to left, transparent, var(--gold));
  }

  .hero-saga {
    font-family: 'Cormorant Garamond', serif;
    font-size: 12.48px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(97, 10, 30, 0.65);
    font-weight: 300;
    margin-top: 0 !important;
    animation: fadeUp 0.9s ease both 0.12s;
  }

  .hero-title {
    font-family: 'Cinzel', serif;
    font-size: clamp(64px, 10vw, 152px);
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 0.95;
    margin-bottom: 0;
    animation: fadeUp 1s ease both 0.22s;
    position: relative;
    margin-top: 0;
  }

  /* glowing text effect — each letter layers */
  .hero-title .t-e {
    color: #5aaad4;
    text-shadow:
      0 0 40px rgba(90, 170, 212, 0.6),
      0 0 80px rgba(90, 170, 212, 0.2);
  }
  .hero-title .t-v {
    color: #f07a30;
    text-shadow:
      0 0 40px rgba(240, 122, 48, 0.6),
      0 0 80px rgba(240, 122, 48, 0.2);
  }
  .hero-title .t-r {
    color: var(--burg);
    text-shadow: none;
  }
  .hero-title .t-f {
    color: #7aaa5a;
    text-shadow:
      0 0 40px rgba(122, 170, 90, 0.6),
      0 0 80px rgba(122, 170, 90, 0.2);
  }
  .hero-title .t-l {
    color: #c0d4ec;
    text-shadow:
      0 0 40px rgba(192, 212, 236, 0.6),
      0 0 80px rgba(192, 212, 236, 0.2);
  }
  .hero-title .t-o {
    color: var(--burg);
    text-shadow: none;
  }
  .hero-title .t-w {
    color: #5aaad4;
    text-shadow: 0 0 35px rgba(90, 170, 212, 0.5);
  }

  .hero-tagline {
    font-family: 'EB Garamond', serif;
    font-size: clamp(16px, 2vw, 21.6px);
    font-style: italic;
    color: rgba(97, 10, 30, 0.65);
    max-width: 560px;
    margin: 0 auto 18px;
    line-height: 1.75;
    margin-top: 0 !important;
    animation: fadeUp 1s ease both 0.36s;
  }
  .hero-tagline span {
    color: var(--gold);
  }

  .hero-lines {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-bottom: 48px;
    animation: fadeUp 1s ease both 0.46s;
  }
  .hero-line {
    font-family: 'Cormorant Garamond', serif;
    font-size: 16px;
    font-style: italic;
    color: rgba(97, 10, 30, 0.65);
    letter-spacing: 0.02em;
    margin: 0 !important;
  }

  .hero-ctas {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
    animation: fadeUp 1s ease both 0.58s;
  }

  /* element badges row */
  .element-badges {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 52px;
    animation: fadeUp 1s ease both 0.72s;
  }
  .elem-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    border: 1px solid;
    padding: 7px 16px;
    font-family: 'Cinzel', serif;
    font-size: 9.6px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    transition: all 0.3s;
    cursor: default;
  }
  .eb-water {
    border-color: rgba(90, 170, 212, 0.4);
    color: var(--water-lt);
  }
  .eb-water:hover {
    background: rgba(42, 106, 154, 0.18);
    border-color: var(--water-lt);
  }
  .eb-fire {
    border-color: rgba(240, 122, 48, 0.4);
    color: var(--fire-lt);
  }
  .eb-fire:hover {
    background: rgba(196, 74, 24, 0.18);
    border-color: var(--fire-lt);
  }
  .eb-earth {
    border-color: rgba(122, 170, 90, 0.4);
    color: var(--earth-lt);
  }
  .eb-earth:hover {
    background: rgba(74, 122, 52, 0.18);
    border-color: var(--earth-lt);
  }
  .eb-air {
    border-color: rgba(192, 212, 236, 0.4);
    color: var(--air-lt);
  }
  .eb-air:hover {
    background: rgba(138, 160, 192, 0.18);
    border-color: var(--air-lt);
  }
  .eb-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }
  .eb-dot-water {
    background: var(--water-lt);
    box-shadow: 0 0 8px var(--water-lt);
  }
  .eb-dot-fire {
    background: var(--fire-lt);
    box-shadow: 0 0 8px var(--fire-lt);
  }
  .eb-dot-earth {
    background: var(--earth-lt);
    box-shadow: 0 0 8px var(--earth-lt);
  }
  .eb-dot-air {
    background: var(--air-lt);
    box-shadow: 0 0 8px var(--air-lt);
  }

  /* scroll cue */
  .scroll-cue {
    position: absolute;
    bottom: 38px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    animation: fadeUp 1s ease both 1.2s;
  }
  .scroll-cue span {
    font-size: 8.96px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(97, 10, 30, 0.5);
  }
  .scroll-line {
    width: 1px;
    height: 50px;
    background: linear-gradient(to bottom, var(--gold), transparent);
    animation: scrollDrop 2.4s ease-in-out infinite;
  }
  @keyframes scrollDrop {
    0% {
      opacity: 0.2;
      transform: scaleY(0.6) translateY(-10px);
    }
    50% {
      opacity: 0.8;
      transform: scaleY(1) translateY(0);
    }
    100% {
      opacity: 0.2;
      transform: scaleY(0.6) translateY(10px);
    }
  }

  /* ═══════════════════════════════════════
   BUTTONS
═══════════════════════════════════════ */
  .btn-primary {
    display: inline-block;
    background: var(--burg);
    color: var(--void);
    padding: 15px 38px;
    font-family: 'Jost', sans-serif;
    font-size: 11.2px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 600;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: all 0.28s;
    position: relative;
    overflow: hidden;
  }
  .btn-primary::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--burg-lt);
    transform: translateX(-100%);
    transition: transform 0.32s ease;
  }
  .btn-primary:hover::before {
    transform: translateX(0);
  }
  .btn-primary span {
    position: relative;
    z-index: 1;
  }

  .btn-ghost-light {
    display: inline-block;
    background: var(--burg);
    color: var(--void);
    padding: 14px 38px;
    font-family: 'Jost', sans-serif;
    font-size: 11.2px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 500;
    text-decoration: none;
    border: 1px solid rgba(250, 246, 237, 0.3);
    cursor: pointer;
    transition: all 0.25s;
  }
  .btn-ghost-light:hover {
    border-color: var(--gold);
    color: var(--gold);
  }

  .btn-gold {
    display: inline-block;
    background: var(--gold);
    color: var(--void);
    padding: 15px 38px;
    font-family: 'Jost', sans-serif;
    font-size: 11.2px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 700;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: background 0.25s;
  }
  .btn-gold:hover {
    background: var(--gold-lt);
  }

  /* ═══════════════════════════════════════
   ELEMENTS SECTION — 4 QUADRANTS
═══════════════════════════════════════ */
  .elements-section {
    position: relative;
    padding: 0;
    background: #fdf9f4;
    overflow: hidden;
  }

  .elements-header {
    text-align: center;
    padding: 100px 40px 70px;
    position: relative;
    z-index: 2;
  }
  .sec-eyebrow {
    font-family: 'Cinzel', serif;
    font-size: 9.6px;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    color: var(--gold);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-bottom: 20px;
  }
  .sec-eyebrow::before,
  .sec-eyebrow::after {
    content: '';
    display: inline-block;
    width: 30px;
    height: 1px;
    background: var(--gold);
    opacity: 0.5;
  }
  .sec-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(35.2px, 4.5vw, 57.6px);
    font-weight: 400;
    line-height: 1.1;
    color: var(--burg);
    margin: 0;
  }
  .sec-title em {
    font-style: italic;
    color: var(--gold);
  }
  .sec-sub {
    font-family: 'EB Garamond', serif;
    font-size: 16.8px;
    font-style: italic;
    color: rgba(97, 10, 30, 0.7);
    margin-top: 0;
    line-height: 1.7;
  }

  /* 2×2 element grid */
  .element-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
    position: relative;
    z-index: 2;
  }

  .elem-panel {
    position: relative;
    padding: 70px 60px;
    min-height: 420px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    cursor: pointer;
    transition: min-height 0.3s;
  }

  /* per-element background atmospheres */
  .ep-water {
    background: linear-gradient(145deg, #eaf4f9 0%, #d8ebf5 50%, #c4e1f0 100%);
  }
  .ep-fire {
    background: linear-gradient(145deg, #fbeee8 0%, #f7dfd4 50%, #f3d0bc 100%);
  }
  .ep-earth {
    background: linear-gradient(145deg, #edf4eb 0%, #e0ebd9 50%, #d3e2c8 100%);
  }
  .ep-air {
    background: linear-gradient(145deg, #eef1f6 0%, #e1e7f0 50%, #d4dde8 100%);
  }

  /* animated glow behind each panel */
  .ep-glow {
    position: absolute;
    inset: 0;
    opacity: 0.35;
    transition: opacity 0.5s;
    pointer-events: none;
  }
  .elem-panel:hover .ep-glow {
    opacity: 0.65;
  }

  .ep-water .ep-glow {
    background: radial-gradient(ellipse at 40% 60%, rgba(42, 106, 154, 0.7) 0%, transparent 70%);
  }
  .ep-fire .ep-glow {
    background: radial-gradient(ellipse at 60% 60%, rgba(196, 74, 24, 0.7) 0%, transparent 70%);
  }
  .ep-earth .ep-glow {
    background: radial-gradient(ellipse at 40% 60%, rgba(74, 122, 52, 0.7) 0%, transparent 70%);
  }
  .ep-air .ep-glow {
    background: radial-gradient(ellipse at 60% 40%, rgba(138, 160, 192, 0.6) 0%, transparent 70%);
  }

  /* large element SVG icon top of panel */
  .elem-icon-wrap {
    position: absolute;
    top: 36px;
    right: 40px;
    opacity: 0.18;
    transition:
      opacity 0.4s,
      transform 0.4s;
  }
  .elem-panel:hover .elem-icon-wrap {
    opacity: 0.38;
    transform: scale(1.06) rotate(3deg);
  }

  /* small animated element particles */
  .elem-particles {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }

  /* content */
  .elem-content {
    position: relative;
    z-index: 5;
  }
  .elem-rune {
    font-family: 'Cinzel', serif;
    font-size: 9.28px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .ep-water .elem-rune {
    color: var(--water-lt);
  }
  .ep-fire .elem-rune {
    color: var(--fire-lt);
  }
  .ep-earth .elem-rune {
    color: var(--earth-lt);
  }
  .ep-air .elem-rune {
    color: var(--air-lt);
  }

  .elem-name {
    font-family: 'Cinzel', serif;
    font-size: clamp(25.6px, 3vw, 38.4px);
    font-weight: 600;
    letter-spacing: 0.08em;
    margin-bottom: 10px;
    margin-top: 0 !important;
    transition: letter-spacing 0.3s;
  }
  .elem-panel:hover .elem-name {
    letter-spacing: 0.12em;
  }
  .ep-water .elem-name {
    color: #7ac8e8;
  }
  .ep-fire .elem-name {
    color: #f09060;
  }
  .ep-earth .elem-name {
    color: #9acd78;
  }
  .ep-air .elem-name {
    color: #c0d8f0;
  }

  .elem-char {
    font-family: 'EB Garamond', serif;
    font-size: 14.4px;
    font-style: italic;
    color: rgba(97, 10, 30, 0.65);
    margin-bottom: 14px;
    margin-top: 0 !important;
  }
  .elem-desc {
    font-size: 13.76px;
    color: rgba(97, 10, 30, 0.7);
    line-height: 1.75;
    font-weight: 300;
    max-width: 340px;
    transition: color 0.3s;
  }
  .elem-panel:hover .elem-desc {
    color: rgba(97, 10, 30, 0.9);
  }

  /* line between panels — glowing spine */
  .element-grid::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(to bottom, transparent, var(--gold) 30%, var(--gold) 70%, transparent);
    opacity: 0.25;
    z-index: 10;
    pointer-events: none;
    transform: translateX(-50%);
  }
  .element-grid::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(to right, transparent, var(--gold) 30%, var(--gold) 70%, transparent);
    opacity: 0.25;
    z-index: 10;
    pointer-events: none;
    transform: translateY(-50%);
  }
  /* gold circle at grid centre intersection */
  .elem-center-mark {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 44px;
    height: 44px;
    border: 1px solid var(--gold);
    border-radius: 50%;
    background: var(--deep);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 20;
    pointer-events: none;
  }
  .elem-center-mark::before {
    content: '';
    position: absolute;
    inset: 6px;
    border: 1px solid rgba(196, 150, 78, 0.4);
    border-radius: 50%;
  }
  .elem-center-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--gold);
    box-shadow:
      0 0 12px var(--gold),
      0 0 24px rgba(196, 150, 78, 0.5);
    animation: centerPulse 2.5s ease-in-out infinite;
  }
  @keyframes centerPulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 12px var(--gold);
    }
    50% {
      transform: scale(1.3);
      box-shadow:
        0 0 20px var(--gold),
        0 0 40px rgba(196, 150, 78, 0.4);
    }
  }

  /* ═══════════════════════════════════════
   SYNOPSIS / BOOK REVEAL SECTION
═══════════════════════════════════════ */
  .synopsis-section {
    padding: 120px 80px;
    background: transparent;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 90px;
    align-items: center;
    position: relative;
    overflow: hidden;
  }

  /* atmospheric background */
  .synopsis-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 80% at 80% 50%, rgba(107, 26, 42, 0.05) 0%, transparent 60%),
      radial-gradient(ellipse 40% 50% at 15% 30%, rgba(42, 106, 154, 0.1) 0%, transparent 55%),
      radial-gradient(ellipse 30% 40% at 10% 80%, rgba(74, 122, 52, 0.08) 0%, transparent 50%);
    pointer-events: none;
  }

  /* 3D rotating book */
  .book-showcase {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }
  .book-3d {
    width: 477px;
    transform: perspective(1200px) rotateY(-22deg) rotateX(2deg);
    transform-style: preserve-3d;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    cursor: pointer;
    position: relative;
  }
  .book-3d:hover {
    transform: perspective(1200px) rotateY(-10deg) rotateX(1deg) translateY(-8px);
  }
  .book-face {
    width: 477px;
    height: 344px;
    border-radius: 2px 5px 5px 2px;
    position: relative;
    overflow: hidden;
    box-shadow:
      8px 12px 40px rgba(0, 0, 0, 0.7),
      -6px 0 0 rgba(0, 0, 0, 0.4),
      inset -2px 0 8px rgba(0, 0, 0, 0.3);
  }

  /* book cover — deep ocean + element swirls */
  .book-cover-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(145deg, #1a2a40 0%, #1d3350 40%, #1a2838 100%);
  }
  .book-cover-art {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 22px 18px;
  }

  /* spine shadow on left edge of book */
  .book-spine {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 16px;
    background: linear-gradient(to right, #040c18, #0d1e38);
    z-index: 2;
  }

  /* top & bottom foil bands */
  .book-band {
    position: absolute;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(to right, var(--gold), var(--gold-lt), var(--gold));
    opacity: 0.7;
  }
  .book-band-top {
    top: 20px;
  }
  .book-band-bot {
    bottom: 20px;
  }

  /* glow aura around book */
  .book-glow {
    position: absolute;
    inset: -30px;
    background:
      radial-gradient(ellipse 60% 80% at 50% 50%, rgba(42, 106, 154, 0.22) 0%, transparent 60%),
      radial-gradient(ellipse 40% 50% at 30% 80%, rgba(196, 74, 24, 0.14) 0%, transparent 55%);
    z-index: -1;
    pointer-events: none;
    animation: bookAura 4s ease-in-out infinite;
  }
  @keyframes bookAura {
    0%,
    100% {
      opacity: 0.7;
    }
    50% {
      opacity: 1;
    }
  }

  /* synopsis text side */
  .syn-eyebrow {
    font-family: 'Cinzel', serif;
    font-size: 9.28px;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--gold);
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 22px;
  }
  .syn-eyebrow::before {
    content: '';
    display: inline-block;
    width: 26px;
    height: 1px;
    background: var(--gold);
    opacity: 0.5;
  }

  .syn-title {
    font-family: 'Cinzel', serif;
    font-size: clamp(35.2px, 4vw, 51.2px);
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1.08;
    margin-bottom: 8px;
    color: var(--burg);
    margin-top: 0 !important;
  }
  .syn-series {
    font-family: 'Cormorant Garamond', serif;
    font-size: 17.6px;
    font-style: italic;
    color: rgba(97, 10, 30, 0.65);
    margin-bottom: 36px;
    letter-spacing: 0.05em;
    margin-top: 0 !important;
  }
  .syn-lines {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-bottom: 36px;
    border-left: 2px solid rgba(196, 150, 78, 0.3);
    padding-left: 24px;
  }
  .syn-line {
    font-family: 'EB Garamond', serif;
    font-size: 17.92px;
    font-style: italic;
    color: rgba(97, 10, 30, 0.8);
    line-height: 1.75;
    padding: 3px 0;
    margin-top: 0 !important;
  }
  .syn-line b {
    color: var(--gold);
    font-style: normal;
    font-weight: 500;
  }
  .syn-divider {
    height: 1px;
    width: 40px;
    background: rgba(196, 150, 78, 0.3);
    margin: 10px 0;
  }
  .syn-body {
    font-size: 14.88px;
    color: rgba(97, 10, 30, 0.7);
    line-height: 1.9;
    font-weight: 300;
    margin-bottom: 36px;
    margin-top: 0 !important;
  }
  .syn-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 36px;
  }
  .syn-tag {
    border: 1px solid rgba(196, 150, 78, 0.3);
    color: var(--gold);
    font-size: 9.6px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 5px 14px;
    font-family: 'Cinzel', serif;
    font-weight: 400;
  }
  .syn-ctas {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  /* ═══════════════════════════════════════
   CHARACTERS / STUDENTS SECTION
═══════════════════════════════════════ */
  .characters-section {
    padding: 110px 80px;
    background: #fdf9f4;
    position: relative;
    overflow: hidden;
  }
  .characters-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 80% 60% at 50% 30%, rgba(107, 26, 42, 0.05) 0%, transparent 65%);
    pointer-events: none;
  }

  .char-header {
    text-align: center;
    margin-bottom: 72px;
    position: relative;
  }

  .char-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    position: relative;
  }

  .char-card {
    position: relative;
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .char-card:hover {
    transform: translateY(-8px);
  }

  .char-portrait {
    aspect-ratio: 3/4;
    position: relative;
    overflow: hidden;
  }

  /* per-character atmospheric portrait */
  .cp-water-student {
    background: linear-gradient(165deg, #d8ebf5 0%, #c4e1f0 40%, #b0d7eb 100%);
  }
  .cp-fire-student {
    background: linear-gradient(165deg, #f7dfd4 0%, #f3d0bc 40%, #eebd9f 100%);
  }
  .cp-earth-student {
    background: linear-gradient(165deg, #e0ebd9 0%, #d3e2c8 40%, #c5d8b5 100%);
  }
  .cp-air-student {
    background: linear-gradient(165deg, #e1e7f0 0%, #d4dde8 40%, #c7d3df 100%);
  }

  /* glowing element aura inside portrait */
  .char-aura {
    position: absolute;
    inset: 0;
    opacity: 0.5;
    transition: opacity 0.4s;
  }
  .char-card:hover .char-aura {
    opacity: 0.85;
  }
  .ca-water {
    background: radial-gradient(ellipse 70% 80% at 50% 70%, rgba(42, 106, 154, 0.7) 0%, transparent 65%);
  }
  .ca-fire {
    background: radial-gradient(ellipse 70% 80% at 50% 70%, rgba(196, 74, 24, 0.7) 0%, transparent 65%);
  }
  .ca-earth {
    background: radial-gradient(ellipse 70% 80% at 50% 70%, rgba(74, 122, 52, 0.7) 0%, transparent 65%);
  }
  .ca-air {
    background: radial-gradient(ellipse 70% 80% at 50% 70%, rgba(138, 160, 192, 0.6) 0%, transparent 65%);
  }

  /* silhouette figure */
  .char-figure {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 0;
    z-index: 2;
  }
  .char-figure svg {
    width: 65%;
  }

  /* floating element glyph in portrait */
  .char-glyph {
    position: absolute;
    top: 20px;
    right: 18px;
    font-size: 35.2px;
    opacity: 0.18;
    z-index: 3;
    transition:
      opacity 0.4s,
      transform 0.4s;
    animation: glyphSway ease-in-out infinite;
  }
  .char-card:hover .char-glyph {
    opacity: 0.42;
    transform: scale(1.15);
  }
  @keyframes glyphSway {
    0%,
    100% {
      transform: rotate(-3deg) translateY(0);
    }
    50% {
      transform: rotate(3deg) translateY(-6px);
    }
  }

  /* overlay with name at bottom */
  .char-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(252, 249, 226, 0.95) 0%, rgba(252, 249, 226, 0) 55%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 24px 20px;
    z-index: 4;
  }
  .char-element-tag {
    font-family: 'Cinzel', serif;
    font-size: 8.64px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    margin-bottom: 6px;
  }
  .ct-water {
    color: var(--water-lt);
  }
  .ct-fire {
    color: var(--fire-lt);
  }
  .ct-earth {
    color: var(--earth-lt);
  }
  .ct-air {
    color: var(--air-lt);
  }

  .char-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 21.6px;
    font-weight: 500;
    color: var(--burg);
    margin-bottom: 4px;
    letter-spacing: 0.02em;
    line-height: 1.15;
  }
  .char-role {
    font-family: 'EB Garamond', serif;
    font-size: 13.12px;
    font-style: italic;
    color: rgba(97, 10, 30, 0.65);
  }

  /* hover expand info */
  .char-expand {
    background: rgba(252, 249, 226, 0.98);
    border-top: 1px solid rgba(196, 150, 78, 0.15);
    padding: 18px 20px;
    transform: translateY(100%);
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    z-index: 5;
  }
  .char-card:hover .char-expand {
    transform: translateY(0);
  }
  .char-expand p {
    font-size: 12.8px;
    color: rgba(97, 10, 30, 0.7);
    line-height: 1.65;
    font-weight: 300;
    font-style: italic;
    font-family: 'EB Garamond', serif;
  }

  /* ═══════════════════════════════════════
   TEASER / QUOTE SECTION
═══════════════════════════════════════ */
  .teaser-section {
    padding: 120px 80px;
    background: transparent;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  /* giant watermark rune */
  .teaser-section::before {
    content: '⚖';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 640px;
    line-height: 1;
    color: rgba(196, 150, 78, 0.025);
    pointer-events: none;
    z-index: 0;
  }

  .teaser-content {
    position: relative;
    z-index: 2;
  }

  .teaser-eyebrow {
    font-family: 'Cinzel', serif;
    font-size: 9.6px;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }
  .teaser-eyebrow::before,
  .teaser-eyebrow::after {
    content: '';
    display: inline-block;
    width: 50px;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--gold));
  }
  .teaser-eyebrow::after {
    background: linear-gradient(to left, transparent, var(--gold));
  }

  .teaser-quote {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(25.6px, 3.5vw, 44.8px);
    font-weight: 400;
    font-style: italic;
    line-height: 1.45;
    color: rgba(97, 10, 30, 1);
    max-width: 800px;
    margin: 0 auto 50px;
    position: relative;
  }
  .teaser-quote::before {
    content: '\201C';
    position: absolute;
    top: -30px;
    left: -20px;
    font-size: 96px;
    line-height: 1;
    color: rgba(196, 150, 78, 0.15);
    font-family: 'Cormorant Garamond', serif;
  }
  .teaser-quote .highlight-water {
    color: var(--water-lt);
  }
  .teaser-quote .highlight-fire {
    color: var(--fire-lt);
  }
  .teaser-quote .highlight-earth {
    color: var(--earth-lt);
  }
  .teaser-quote .highlight-air {
    color: var(--air-lt);
  }

  /* 4 element icon row */
  .elem-icon-row {
    display: flex;
    gap: 24px;
    justify-content: center;
    margin: 50px 0;
  }
  .ei-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    cursor: default;
  }
  .ei-circle {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    border: 1px solid;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s;
    position: relative;
  }
  .ei-circle::before {
    content: '';
    position: absolute;
    inset: 6px;
    border-radius: 50%;
    border: 1px solid;
    opacity: 0.4;
    transition: opacity 0.3s;
  }
  .ei-item:hover .ei-circle::before {
    opacity: 0.9;
  }

  .ei-water {
    border-color: rgba(90, 170, 212, 0.4);
  }
  .ei-water::before {
    border-color: var(--water-lt) !important;
  }
  .ei-water:hover {
    background: rgba(42, 106, 154, 0.15);
    border-color: var(--water-lt);
    box-shadow: 0 0 24px rgba(42, 106, 154, 0.3);
  }
  .ei-fire {
    border-color: rgba(240, 122, 48, 0.4);
  }
  .ei-fire::before {
    border-color: var(--fire-lt) !important;
  }
  .ei-fire:hover {
    background: rgba(196, 74, 24, 0.15);
    border-color: var(--fire-lt);
    box-shadow: 0 0 24px rgba(196, 74, 24, 0.3);
  }
  .ei-earth {
    border-color: rgba(122, 170, 90, 0.4);
  }
  .ei-earth::before {
    border-color: var(--earth-lt) !important;
  }
  .ei-earth:hover {
    background: rgba(74, 122, 52, 0.15);
    border-color: var(--earth-lt);
    box-shadow: 0 0 24px rgba(74, 122, 52, 0.3);
  }
  .ei-air {
    border-color: rgba(192, 212, 236, 0.4);
  }
  .ei-air::before {
    border-color: var(--air-lt) !important;
  }
  .ei-air:hover {
    background: rgba(138, 160, 192, 0.15);
    border-color: var(--air-lt);
    box-shadow: 0 0 24px rgba(138, 160, 192, 0.25);
  }

  .ei-label {
    font-family: 'Cinzel', serif;
    font-size: 8.96px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(97, 10, 30, 0.6);
  }

  /* ═══════════════════════════════════════
   ABOUT JESSIE — WARM & ATMOSPHERIC
═══════════════════════════════════════ */
  .author-section {
    padding: 120px 90px;
    background: var(--void);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
    position: relative;
    overflow: hidden;
  }
  .author-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 60% at 30% 50%, rgba(107, 26, 42, 0.07) 0%, transparent 65%),
      radial-gradient(ellipse 50% 40% at 80% 30%, rgba(184, 146, 74, 0.06) 0%, transparent 55%);
    pointer-events: none;
  }
  .author-section::after {
    content: '';
    position: fixed;
    inset: 0;
    background-image: repeating-linear-gradient(
      180deg,
      transparent 0px,
      transparent 31px,
      var(--page-line) 31px,
      var(--page-line) 32px
    );
    pointer-events: none;
    z-index: 0;
  }

  .author-frame {
    position: relative;
    z-index: 1;
  }
  .author-frame::before {
    content: '';
    position: absolute;
    top: -20px;
    left: -20px;
    right: 20px;
    bottom: 20px;
    border: 1px solid rgba(184, 146, 74, 0.3);
    z-index: 2;
    pointer-events: none;
  }
  .author-frame::after {
    content: '';
    position: absolute;
    top: -8px;
    left: -8px;
    right: 8px;
    bottom: 8px;
    border: 1px solid rgba(184, 146, 74, 0.12);
    z-index: 2;
    pointer-events: none;
  }
  .author-img {
    width: 100%;
    aspect-ratio: 4/5;
    background: linear-gradient(160deg, #f5eaec 0%, #e8d8d0 35%, #d8c0b8 65%, #c8a8a0 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 80px;
    position: relative;
    z-index: 1;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(74, 15, 28, 0.15);
  }
  .author-img img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    z-index: 1;
  }
  .author-img .img-placeholder {
    position: relative;
    z-index: 1;
    opacity: 0.55;
  }

  .auth-tag {
    display: inline-block;
    border: 1px solid rgba(196, 150, 78, 0.3);
    color: var(--gold);
    font-family: 'Cinzel', serif;
    font-size: 9.28px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    padding: 5px 14px;
    margin-bottom: 22px;
  }
  .auth-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(32px, 3.5vw, 48px);
    font-weight: 400;
    line-height: 1.12;
    color: var(--burg);
    margin-bottom: 8px;
    margin-top: 0 !important;
  }
  .auth-title em {
    font-style: italic;
    color: var(--gold);
  }
  .auth-role {
    font-family: 'EB Garamond', serif;
    font-size: 16px;
    font-style: italic;
    color: rgba(97, 10, 30, 0.6);
    margin-bottom: 28px;
    margin-top: 0 !important;
  }
  .auth-quote {
    border-left: 2px solid rgba(196, 150, 78, 0.35);
    padding-left: 22px;
    margin-bottom: 26px;
    font-family: 'EB Garamond', serif;
    font-size: 17.28px;
    font-style: italic;
    color: rgba(97, 10, 30, 0.7);
    line-height: 1.7;
    margin-top: 0 !important;
  }
  .auth-body {
    font-size: 14.4px;
    color: rgba(97, 10, 30, 0.65);
    line-height: 1.9;
    font-weight: 300;
    margin-bottom: 32px;
    margin-top: 0 !important;
  }

  /* ═══════════════════════════════════════
   NEWSLETTER
═══════════════════════════════════════ */
  .nl-section {
    padding: 90px;
    background: var(--burg);
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .nl-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      180deg,
      transparent 0px,
      transparent 33px,
      rgba(255, 255, 255, 0.04) 33px,
      rgba(255, 255, 255, 0.04) 34px
    );
    pointer-events: none;
  }
  .nl-section::after {
    content: '⚖';
    position: absolute;
    font-size: 320px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    opacity: 0.04;
    pointer-events: none;
  }
  .nl-over {
    color: rgba(252, 249, 226, 0.8) !important;
    font-family: 'Cinzel', serif;
    font-size: 9.6px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    display: block;
    margin-bottom: 16px;
    position: relative;
  }
  .nl-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(28.8px, 3.5vw, 48px);
    font-weight: 400;
    color: var(--void) !important;
    margin-bottom: 14px;
    margin-top: 0 !important;
    position: relative;
  }
  .nl-title em {
    font-style: italic;
  }
  .nl-desc {
    color: rgba(250, 246, 237, 0.6);
    font-size: 14.72px;
    font-weight: 300;
    max-width: 440px;
    margin: 0 auto 36px;
    line-height: 1.8;
    position: relative;
  }
  .nl-form {
    display: flex;
    max-width: 400px;
    margin: 0 auto;
    position: relative;
  }
  .nl-input {
    flex: 1;
    padding: 15px 20px;
    font-family: 'Jost', sans-serif;
    font-size: 13.44px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.08);
    color: var(--void);
    outline: none;
  }
  .nl-input::placeholder {
    color: rgba(250, 246, 237, 0.3);
  }
  .nl-btn {
    padding: 15px 26px;
    background: var(--gold);
    color: var(--void);
    font-family: 'Jost', sans-serif;
    font-size: 10.72px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 700;
    border: none;
    cursor: pointer;
    transition: background 0.2s;
  }
  .nl-btn:hover {
    background: var(--gold-lt);
  }

  /* ═══════════════════════════════════════
   ANIMATIONS
═══════════════════════════════════════ */
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(28px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes waterFlow {
    0%,
    100% {
      d: path('M0,50 Q50,20 100,50 Q150,80 200,50 L200,100 L0,100 Z');
    }
    50% {
      d: path('M0,50 Q50,80 100,50 Q150,20 200,50 L200,100 L0,100 Z');
    }
  }
  @keyframes fireFlicker {
    0%,
    100% {
      transform: scaleY(1) scaleX(1);
      opacity: 0.8;
    }
    33% {
      transform: scaleY(1.1) scaleX(0.95);
      opacity: 1;
    }
    66% {
      transform: scaleY(0.92) scaleX(1.04);
      opacity: 0.7;
    }
  }
  @keyframes leafSway {
    0%,
    100% {
      transform: rotate(-5deg) translateY(0);
    }
    50% {
      transform: rotate(5deg) translateY(-10px);
    }
  }
  @keyframes mistDrift {
    0% {
      transform: translateX(0) translateY(0);
      opacity: 0.15;
    }
    50% {
      transform: translateX(20px) translateY(-15px);
      opacity: 0.25;
    }
    100% {
      transform: translateX(0) translateY(0);
      opacity: 0.15;
    }
  }

  /* scroll-reveal helper */
  .reveal {
    opacity: 0;
    transform: translateY(32px);
    transition:
      opacity 0.8s ease,
      transform 0.8s ease;
  }
  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Responsive Media Queries */
  @media screen and (max-width: 1024px) {
    .char-grid {
      grid-template-columns: repeat(2, 1fr) !important;
    }
