<script>
  /* ── Starfield ── */
  const starContainer = document.getElementById('stars');
  for (let i = 0; i < 90; i++) {
    const s = document.createElement('div');
    s.className = 'star';
    const size = Math.random() * 2.2 + 0.4;
    s.style.cssText = `
    width:${size}px; height:${size}px;
    left:${Math.random() * 100}%;
    top:${Math.random() * 100}%;
    animation-duration:${2.5 + Math.random() * 5}s;
    animation-delay:${-Math.random() * 6}s;
  `;
    starContainer.appendChild(s);
  }

  /* ── Rune / symbol particles ── */
  const runeSymbols = ['⟨', '⟩', '∿', '≈', '∴', '✦', '◈', '⌬', '⊕', '⊗', '✧', '∞'];
  const runeContainer = document.getElementById('runes');
  function spawnRune() {
    const el = document.createElement('div');
    el.className = 'rune-particle';
    el.textContent = runeSymbols[Math.floor(Math.random() * runeSymbols.length)];
    const size = 0.6 + Math.random() * 0.7;
    const dur = 8 + Math.random() * 12;
    const del = Math.random() * 4;
    el.style.cssText = `
    font-size:${size}rem;
    left:${10 + Math.random() * 80}%;
    bottom:${15 + Math.random() * 50}%;
    animation-duration:${dur}s;
    animation-delay:${del}s;
    opacity:0;
  `;
    runeContainer.appendChild(el);
    setTimeout(() => elNaNpxove(), (dur + del + 1) * 1000);
  }
  setInterval(spawnRune, 2200);
  spawnRune();
  spawnRune();
  spawnRune();

  /* ── Scroll reveal ── */
  const revealEls = document.querySelectorAll('.reveal');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
          observer.unobserve(e.target);
        }
      });
    },
    { threshold: 0.1 },
  );
  revealEls.forEach((el) => observer.observe(el));
</script>

