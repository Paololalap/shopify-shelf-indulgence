  <script>
/* ── state ── */
let selectedGenre = null;
let selectedSize  = null;

const genreNames = {
{% if products.size > 0 %}
  {% for product in products limit: 4 %}
    {% assign gk = genre_keys[forloop.index0] %}
    {% assign cl = color_labels[forloop.index0] %}
    {% assign gl = genre_labels[forloop.index0] %}
    '{{ gk }}': '{{ product.title }} — {{ gl }} · {{ cl }}'{% unless forloop.last %},{% endunless %}
  {% endfor %}
{% else %}
  {% for i in (0..3) %}
    {% assign gk = genre_keys[i] %}
    {% assign cl = color_labels[i] %}
    {% assign gl = genre_labels[i] %}
    '{{ gk }}': '{{ static_titles[i] }} — {{ gl }} · {{ cl }}'{% unless forloop.last %},{% endunless %}
  {% endfor %}
{% endif %}
};

const variantMap = {
{% if products.size > 0 %}
  {% for product in products limit: 4 %}
    {% assign gk = genre_keys[forloop.index0] %}
    '{{ gk }}': {
      {% for variant in product.variants %}
        '{{ variant.title }}': {{ variant.id }}{% unless forloop.last %},{% endunless %}
      {% endfor %}
    },
  {% endfor %}
{% endif %}
};

/* ── hoodie card click ── */
function selectHoodie(card, genre) {
  document.querySelectorAll('.hoodie-card').forEach(c => c.classList.remove('selected'));
  card.classList.add('selected');
  selectGenre(genre);
  document.getElementById('choose-form').scrollIntoView({ behavior:'smooth', block:'start' });
}

/* ── genre picker in form ── */
function setGenre(genre, el) {
  selectedGenre = genre;
  document.querySelectorAll('.genre-option').forEach(o => o.classList.remove('active'));
  el.classList.add('active');
  document.getElementById('summary-name').textContent = genreNames[genre];
  updateCTA();
}

/* ── size picker ── */
function setSize(btn) {
  document.querySelectorAll('.size-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  selectedSize = btn.textContent;
  document.getElementById('summary-detail').textContent = 'Wear Your Story™ · Size ' + selectedSize;
  updateCTA();
}

function updateCTA() {
  const txt = document.getElementById('cta-text');
  if (selectedGenre && selectedSize) {
    txt.textContent = 'Pre-order Now — AU$125.00';
  } else if (selectedGenre) {
    txt.textContent = 'Select a Size to Continue';
  } else {
    txt.textContent = 'Choose a Genre Above';
  }
}

/* ── selectGenre from showcase (programmatic) ── */
function selectGenre(genre) {
  selectedGenre = genre;
  document.querySelectorAll('.genre-option').forEach(o => {
    o.classList.remove('active');
    if (o.classList.contains('go-'+genre)) o.classList.add('active');
  });
  document.getElementById('summary-name').textContent = genreNames[genre];
  updateCTA();
}

/* ── order handler ── */
function handleOrder() {
  if (!selectedGenre) { alert('Please choose a genre first!'); return; }
  if (!selectedSize)  { alert('Please select your size!'); return; }

  const variantId = variantMap[selectedGenre]?.[selectedSize];
  if (!variantId) {
    alert('Sorry, this combination is not available.');
    return;
  }

  const btn = document.getElementById('orderBtn');
  btn.disabled = true;
  btn.classList.add('loading');

  const formData = new FormData();
  formData.append('id', variantId);
  formData.append('quantity', 1);

  fetch(window.routes.cart_add_url, {
    method: 'POST',
    headers: { 'X-Requested-With': 'XMLHttpRequest' },
    body: formData
  })
  .then(response => response.json())
  .then(() => {
    btn.disabled = false;
    btn.classList.remove('loading');
    showModal(genreNames[selectedGenre], selectedSize);
  })
  .catch(() => {
    btn.disabled = false;
    btn.classList.remove('loading');
    showModal(genreNames[selectedGenre], selectedSize);
  });
}

/* ── success modal ── */
function showModal(productName, size) {
  document.getElementById('modalProduct').textContent = productName;
  document.getElementById('modalSize').textContent = 'Size ' + size;
  document.getElementById('successModal').classList.add('open');
}
function closeModal() {
  document.getElementById('successModal').classList.remove('open');
}

/* ── floating page drifters ── */
const fpContainer = document.getElementById('fp-container');
const pageSVGs = [
  `<svg width="22" height="28" viewBox="0 0 22 28" fill="none"><path d="M2 2 H16 L20 8 V26 H2 Z" fill="#f7f0e4" stroke="#c8a080" stroke-width="0.6"/><path d="M16 2 L16 8 H20" fill="#e8d8b8" stroke="#c8a080" stroke-width="0.6"/><line x1="5" y1="11" x2="17" y2="11" stroke="#d0b888" stroke-width="0.5" opacity="0.5"/><line x1="5" y1="15" x2="17" y2="15" stroke="#d0b888" stroke-width="0.5" opacity="0.5"/><line x1="5" y1="19" x2="14" y2="19" stroke="#d0b888" stroke-width="0.5" opacity="0.5"/></svg>`,
  `<svg width="11" height="22" viewBox="0 0 11 22" fill="none"><path d="M1 1 H10 V21 L5.5 17 L1 21 Z" fill="#6b1a2a" opacity="0.3" stroke="#8b2e40" stroke-width="0.5"/></svg>`,
  `<svg width="26" height="18" viewBox="0 0 26 18" fill="none"><path d="M1 2 Q1 9 1 16 L12 16 Q12 9 13 2 Z" fill="#f7f0e4" stroke="#c8a080" stroke-width="0.5"/><path d="M25 2 Q25 9 25 16 L14 16 Q14 9 13 2 Z" fill="#f7f0e4" stroke="#c8a080" stroke-width="0.5"/><line x1="2" y1="6" x2="11" y2="6" stroke="#d0b888" stroke-width="0.4" opacity="0.5"/><line x1="2" y1="9" x2="11" y2="9" stroke="#d0b888" stroke-width="0.4" opacity="0.5"/><line x1="15" y1="6" x2="24" y2="6" stroke="#d0b888" stroke-width="0.4" opacity="0.5"/><line x1="15" y1="9" x2="24" y2="9" stroke="#d0b888" stroke-width="0.4" opacity="0.5"/><path d="M12 1 Q13 6 12 16 M14 1 Q13 6 14 16" stroke="#b8924a" stroke-width="0.7" fill="none" opacity="0.5"/></svg>`
];

function spawnPage() {
  const div = document.createElement('div');
  div.className = 'float-page';
  div.innerHTML = pageSVGs[Math.floor(Math.random() * pageSVGs.length)];
  const rs = (Math.random() * 20 - 10) + 'deg';
  const re = (Math.random() * 30 - 5) + 'deg';
  div.style.setProperty('--rot-start', rs);
  div.style.setProperty('--rot-end', re);
  div.style.left = (Math.random() * 90) + '%';
  div.style.top  = (60 + Math.random() * 30) + '%';
  const dur = 9 + Math.random() * 10;
  div.style.animationDuration = dur + 's';
  div.style.animationDelay   = (Math.random() * 3) + 's';
  fpContainer.appendChild(div);
  setTimeout(() => div.remove(), (dur + 4) * 1000);
}
setInterval(spawnPage, 3200);
spawnPage(); spawnPage();

/* ── scroll reveal ── */
const observer = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if (e.isIntersecting) {
      e.target.style.animation = 'fadeUp .7s ease both';
      observer.unobserve(e.target);
    }
  });
}, { threshold: 0.1 });
document.querySelectorAll('.hoodie-card, .sig-card, .event-card').forEach(el => observer.observe(el));
  </script>

  <!-- ── success modal ── -->
  <div class='modal-overlay' id='successModal'>
    <div class='modal-box'>
      <div class='modal-icon'>
        <svg
          viewBox='0 0 24 24'
          fill='none'
          stroke='#faf6ed'
          stroke-width='2.5'
          stroke-linecap='round'
          stroke-linejoin='round'
        >
          <path d="M6 12l4 4 8-8"/>
        </svg>
      </div>
      <h3 class='modal-title'>Added to Cart!</h3>
      <p class='modal-product' id='modalProduct'></p>
      <p class='modal-size' id='modalSize'></p>
      <div class='modal-actions'>
        <button class='modal-btn modal-btn-ghost' onclick='closeModal()'>Continue Shopping</button>
        <a href='{{ routes.cart_url }}' class='modal-btn modal-btn-primary'>View Cart</a>
      </div>
    </div>
  </div>
</div>

