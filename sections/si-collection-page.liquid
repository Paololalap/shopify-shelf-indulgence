{{ 'component-price.css' | asset_url | stylesheet_tag }}

<style>
  /* ========== HERO BANNER ========== */
  .si-cp-hero {
    display: flex;
    align-items: center;
    gap: 0;
    max-width: 1430px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem;
  }
  .si-cp-hero-title {
    width: 50%;
    display: flex;
    align-items: center;
  }
  .si-cp-hero-title h1 {
    font-family: var(--si-serif) !important;
    font-size: 44px !important;
    color: var(--si-burg-deep) !important;
    font-weight: 400 !important;
    margin: 0;
    line-height: 1.15;
    letter-spacing: 0.02em;
  }
  .si-cp-hero-img {
    width: 50%;
  }
  .si-cp-hero-img img {
    width: 100%;
    height: 218px;
    object-fit: cover;
    border-radius: 14px;
    display: block;
  }

  .si-cp-filter-bar {
    max-width: 1430px;
    margin: 0 auto;
    padding: 0 1.5rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .si-cp-filter-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .si-cp-product-count {
    font-family: var(--si-sans);
    font-size: 14px;
    font-weight: 400;
    color: var(--si-text-soft);
    letter-spacing: 0.04em;
  }
  .si-cp-filter-label {
    font-family: var(--si-sans);
    font-size: 14px;
    font-weight: 400;
    color: var(--si-text-dark);
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
  .si-cp-filter-dropdown {
    position: relative;
  }
  .si-cp-filter-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 8px 16px;
    background: var(--si-cream);
    border: 1px solid var(--si-cream-border);
    border-radius: 8px;
    font-family: var(--si-sans);
    font-size: 13px;
    font-weight: 400;
    color: var(--si-text-dark);
    cursor: pointer;
    transition: border-color 0.2s, box-shadow 0.2s;
    letter-spacing: 0.03em;
    user-select: none;
  }
  .si-cp-filter-btn:hover {
    border-color: var(--si-burg-light);
  }
  .si-cp-filter-btn svg {
    width: 12px;
    height: 12px;
    transition: transform 0.25s;
  }
  .si-cp-filter-dropdown.open .si-cp-filter-btn svg {
    transform: rotate(180deg);
  }
  .si-cp-filter-panel {
    display: none;
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    min-width: 210px;
    background: #fff;
    border: 1px solid var(--si-cream-border);
    border-radius: 10px;
    padding: 16px;
    box-shadow: 0 8px 24px rgba(30,10,16,0.08);
    z-index: 50;
  }
  .si-cp-filter-dropdown.open .si-cp-filter-panel {
    display: block;
  }
  .si-cp-filter-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
  }
  .si-cp-filter-count {
    font-family: var(--si-sans);
    font-size: 12px;
    color: var(--si-text-soft);
    font-weight: 300;
  }
  .si-cp-filter-reset {
    font-family: var(--si-sans);
    font-size: 12px;
    color: var(--si-burg);
    cursor: pointer;
    text-decoration: underline;
    border: none;
    background: none;
    padding: 0;
    font-weight: 400;
    letter-spacing: 0.02em;
  }
  .si-cp-filter-reset:hover {
    color: var(--si-burg-deep);
  }
  .si-cp-filter-option {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
    cursor: pointer;
    font-family: var(--si-sans);
    font-size: 13px;
    color: var(--si-text-dark);
    font-weight: 300;
  }
  .si-cp-filter-option:last-child {
    margin-bottom: 0;
  }
  .si-cp-filter-option input[type="checkbox"] {
    width: 16px;
    height: 16px;
    accent-color: var(--si-burg);
    border-radius: 3px;
    cursor: pointer;
    margin: 0;
  }

  /* ========== PRODUCT GRID ========== */
  .si-cp-grid {
    max-width: 1430px;
    margin: 0 auto;
    padding: 0 1.5rem 3rem;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .si-cp-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .si-cp-card-img-wrap {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 14px;
    background: var(--si-cream-warm);
    margin-bottom: 12px;
  }
  .si-cp-card-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .si-cp-card:hover .si-cp-card-img-wrap img {
    transform: scale(1.05);
  }
  .si-cp-card-name {
    font-family: var(--si-serif);
    font-size: 15px;
    color: var(--si-text-dark);
    font-weight: 400;
    margin: 0 0 4px;
    line-height: 1.3;
  }
  .si-cp-card-name a {
    text-decoration: none;
    color: inherit;
    transition: color 0.2s;
  }
  .si-cp-card-name a:hover {
    color: var(--si-burg);
  }
  .si-cp-card-price {
    font-family: var(--si-sans);
    font-size: 13px;
    color: var(--si-text-soft);
    font-weight: 300;
    margin: 0 0 10px;
  }
  .si-cp-card-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 10px 0;
    font-family: var(--si-sans) !important;
    font-size: 12px !important;
    font-weight: 400 !important;
    letter-spacing: 0.18em !important;
    text-transform: uppercase !important;
    color: var(--si-cream) !important;
    background: var(--si-burg-deep) !important;
    border: none !important;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.2s;
  }
  .si-cp-card-btn:hover {
    background: var(--si-burg) !important;
  }
  .si-cp-card-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* ========== EMPTY STATE ========== */
  .si-cp-empty {
    max-width: 1430px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
    text-align: center;
    font-family: var(--si-sans);
    color: var(--si-text-soft);
    font-size: 15px;
  }

  /* ========== RESPONSIVE ========== */
  @media screen and (max-width: 989px) {
    .si-cp-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }
  }
  @media screen and (max-width: 749px) {
    .si-cp-hero {
      flex-direction: column;
      gap: 1.25rem;
      padding: 1.5rem 1rem;
    }
    .si-cp-hero-title,
    .si-cp-hero-img {
      width: 100%;
    }
    .si-cp-hero-title h1 {
      font-size: 32px !important;
    }
    .si-cp-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
      padding: 0 1rem 2rem;
    }
    .si-cp-filter-bar {
      padding: 0 1rem 1rem;
      flex-wrap: wrap;
    }
  }
</style>

{%- comment -%} ========== HERO ========== {%- endcomment -%}
<div class="si-cp-hero">
  <div class="si-cp-hero-title">
    <h1>{{ collection.title | escape }}</h1>
  </div>
  <div class="si-cp-hero-img">
    {% if collection.image %}
      <img
        src="{{ collection.image | image_url: width: 800 }}"
        alt="{{ collection.image.alt | default: collection.title | escape }}"
        width="800"
        height="218"
        loading="eager"
      >
    {% else %}
      <div style="width:100%;height:218px;border-radius:14px;background:var(--si-cream-warm);display:flex;align-items:center;justify-content:center;">
        <span style="font-family:var(--si-sans);color:var(--si-text-soft);font-size:13px;">No image</span>
      </div>
    {% endif %}
  </div>
</div>

 {%- comment -%} ========== FILTER ========== {%- endcomment -%}
<div class="si-cp-filter-bar">
  <div class="si-cp-filter-left">
    <span class="si-cp-filter-label">Filter:</span>
    <div class="si-cp-filter-dropdown" id="si-availability-filter">
      <button type="button" class="si-cp-filter-btn" aria-expanded="false" aria-controls="si-avail-panel">
        Availability
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2.5 4.5L6 8l3.5-3.5"/></svg>
      </button>
      <div class="si-cp-filter-panel" id="si-avail-panel">
        <div class="si-cp-filter-header">
          <span class="si-cp-filter-count" id="si-filter-count">0 selected</span>
          <button type="button" class="si-cp-filter-reset" id="si-filter-reset">Reset</button>
        </div>
        <label class="si-cp-filter-option">
          <input type="checkbox" value="in_stock" class="si-avail-check"> In stock
        </label>
        <label class="si-cp-filter-option">
          <input type="checkbox" value="out_of_stock" class="si-avail-check"> Out of stock
        </label>
      </div>
    </div>
  </div>
  <span class="si-cp-product-count">{{ collection.products_count }} products</span>
</div>

{%- comment -%} ========== PRODUCT GRID ========== {%- endcomment -%}
{%- paginate collection.products by section.settings.products_per_page -%}
  {% if collection.products.size > 0 %}
    <div class="si-cp-grid" id="si-cp-product-grid">
      {%- for product in collection.products -%}
        <div
          class="si-cp-card"
          data-available="{{ product.available }}"
        >
          <div class="si-cp-card-top">
            <div class="si-cp-card-img-wrap">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 680 }}"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  width="339"
                  height="339"
                  loading="lazy"
                >
              {% else %}
                <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;">
                  <span style="font-family:var(--si-sans);color:var(--si-text-soft);font-size:13px;">No image</span>
                </div>
              {% endif %}
            </div>
            <p class="si-cp-card-name">
              <a href="{{ product.url }}">{{ product.title }}</a>
            </p>
            <p class="si-cp-card-price">{{ product.price | money }}</p>
          </div>
          {%- if product.available -%}
            <form method="post" action="/cart/add">
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
              <input type="hidden" name="quantity" value="1">
              <button type="submit" class="si-cp-card-btn">Add to Cart</button>
            </form>
          {%- else -%}
            <button type="button" class="si-cp-card-btn" disabled>Sold Out</button>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <div style="max-width:1430px;margin:0 auto;padding:0 1.5rem 3rem;">
        {% render 'pagination', paginate: paginate %}
      </div>
    {%- endif -%}
  {% else %}
    <div class="si-cp-empty">
      <p>No products found in this collection.</p>
    </div>
  {% endif %}
{%- endpaginate -%}

<script>
  (function() {
    /* Toggle dropdown */
    const dropdown = document.getElementById('si-availability-filter');
    const btn = dropdown.querySelector('.si-cp-filter-btn');
    const checks = dropdown.querySelectorAll('.si-avail-check');
    const countEl = document.getElementById('si-filter-count');
    const resetBtn = document.getElementById('si-filter-reset');
    const cards = document.querySelectorAll('.si-cp-card[data-available]');

    btn.addEventListener('click', function() {
      const isOpen = dropdown.classList.toggle('open');
      btn.setAttribute('aria-expanded', isOpen);
    });

    /* Close on outside click */
    document.addEventListener('click', function(e) {
      if (!dropdown.contains(e.target)) {
        dropdown.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
      }
    });

    function applyFilter() {
      const selected = Array.from(checks).filter(c => c.checked);
      const count = selected.length;
      countEl.textContent = count + ' selected';

      if (count === 0) {
        cards.forEach(function(c) { c.style.display = ''; });
        return;
      }

      const showIn = selected.some(c => c.value === 'in_stock');
      const showOut = selected.some(c => c.value === 'out_of_stock');

      cards.forEach(function(card) {
        const avail = card.getAttribute('data-available') === 'true';
        if ((showIn && avail) || (showOut && !avail)) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    }

    checks.forEach(function(c) {
      c.addEventListener('change', applyFilter);
    });

    resetBtn.addEventListener('click', function() {
      checks.forEach(function(c) { c.checked = false; });
      applyFilter();
    });
  })();
</script>

{% schema %}
{
  "name": "SI Collection Page",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 4,
      "max": 36,
      "step": 4,
      "default": 16,
      "label": "Products per page"
    }
  ]
}
{% endschema %}
