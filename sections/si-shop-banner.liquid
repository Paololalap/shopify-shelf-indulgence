<style>
  .si-shop-banner {
    width: 100%;
    height: 435px;
    background-image: url('{{ 'lost-in-dreams.jpg' | asset_url }}');
    background-size: cover;
    background-position: top;
    background-repeat: no-repeat;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .si-shop-banner-heading {
    color: #fcf9e2 !important;
    font-size: 50px;
    text-align: center;
    font-weight: 500 !important;
    font-family: var(--si-serif);
    margin: 0;
    text-transform: none;
    letter-spacing: 0.1em;
    text-wrap: balance;
    max-width: 800px;
    padding: 0 20px;
  }
  @media screen and (max-width: 749px) {
    .si-shop-banner {
      height: 450px;
      background-size: cover;
    }
    .si-shop-banner-heading {
      font-size: 32px;
    }
  }
</style>

<div class='si-shop-banner'>
  <h1 class='si-shop-banner-heading'>Shelf Indulgence Products</h1>
</div>

{% schema %}
{
  "name": "SI Shop Banner",
  "settings": [],
  "presets": [
    {
      "name": "SI Shop Banner"
    }
  ]
}
{% endschema %}
