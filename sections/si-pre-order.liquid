<link
  href='https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500;1,600&family=EB+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=Jost:wght@200;300;400;500;600&display=swap'
  rel='stylesheet'
>

{%- style -%}
  /* ═══════════════════════════════════════════
   ROOT & TOKENS
═══════════════════════════════════════════ */
  :root {
    --burg: #6b1a2a;
    --burg-dk: #4a0f1c;
    --burg-lt: #8b2e40;
    --burg-soft: #c4707a;
    --burg-xs: #f5eaec;
    --cream: #faf6ed;
    --cream-dk: #f0e8d8;
    --cream-wm: #e8dcc8;
    --parchment: #f7f1e4;
    --gold: #b8924a;
    --gold-lt: #d4b870;
    --gold-pale: #f0e4c8;
    --ink: #1e0e14;
    --muted: #7a6068;
    --muted-lt: #a89098;
    --page-line: rgba(184, 146, 74, 0.1);

    /* hoodie theme colours */
    --pink-hoodie: #f0c8d0;
    --blue-hoodie: #bcd4e8;
    --grey-hoodie: #c8c4c0;
    --purple-hoodie: #c8b0e0;
  }

  .si-preorder-full-page,
  .si-preorder-full-page *,
  .si-preorder-full-page *::before,
  .si-preorder-full-page *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }
  html {
    scroll-behavior: smooth;
  }

  .si-preorder-full-page {
    font-family: 'Jost', sans-serif;
    background: var(--cream);
    color: var(--ink);
    overflow-x: hidden;
    min-height: 100vh;
  }

  /* ═══════════════════════════════════════════
   DREAMY PAGE-LINES TEXTURE
═══════════════════════════════════════════ */
  .si-preorder-full-page::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image: repeating-linear-gradient(
      180deg,
      transparent 0px,
      transparent 31px,
      var(--page-line) 31px,
      var(--page-line) 32px
    );
    pointer-events: none;
    z-index: 0;
  }

  /* ═══════════════════════════════════════════
   HERO — DREAMY ATMOSPHERIC
═══════════════════════════════════════════ */
  .si-preorder-full-page .hero {
    position: relative;
    min-height: 88vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    padding: 80px 40px 60px;
    z-index: 1;
  }

  /* misty radial atmosphere */
  .si-preorder-full-page .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 60% at 50% 40%, rgba(107, 26, 42, 0.13) 0%, transparent 70%),
      radial-gradient(ellipse 50% 40% at 20% 80%, rgba(184, 146, 74, 0.08) 0%, transparent 60%),
      radial-gradient(ellipse 50% 40% at 80% 10%, rgba(107, 26, 42, 0.07) 0%, transparent 60%);
    pointer-events: none;
  }

  /* floating dreamy orbs */
  .si-preorder-full-page .orb {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    animation: floatOrb ease-in-out infinite;
  }
  .si-preorder-full-page .orb-1 {
    width: 320px;
    height: 320px;
    background: radial-gradient(circle, rgba(107, 26, 42, 0.09), transparent 70%);
    top: -60px;
    left: -80px;
    animation-duration: 14s;
  }
  .si-preorder-full-page .orb-2 {
    width: 260px;
    height: 260px;
    background: radial-gradient(circle, rgba(184, 146, 74, 0.08), transparent 70%);
    top: 40%;
    right: -60px;
    animation-duration: 18s;
    animation-delay: -5s;
  }
  .si-preorder-full-page .orb-3 {
    width: 180px;
    height: 180px;
    background: radial-gradient(circle, rgba(107, 26, 42, 0.07), transparent 70%);
    bottom: -40px;
    left: 30%;
    animation-duration: 12s;
    animation-delay: -8s;
  }

  @keyframes floatOrb {
    0%,
    100% {
      transform: translateY(0) scale(1);
    }
    50% {
      transform: translateY(-30px) scale(1.08);
    }
  }

  /* scattered floating pages */
  .si-preorder-full-page .float-page {
    position: absolute;
    pointer-events: none;
    opacity: 0;
    animation: floatPage linear infinite;
  }
  @keyframes floatPage {
    0% {
      opacity: 0;
      transform: translateY(60px) rotate(var(--rot-start));
    }
    15% {
      opacity: 0.22;
    }
    85% {
      opacity: 0.16;
    }
    100% {
      opacity: 0;
      transform: translateY(-80px) rotate(var(--rot-end));
    }
  }

  .si-preorder-full-page .hero-eyebrow {
    font-size: 10.4px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--gold);
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 22px;
    animation: fadeUp 0.9s ease both 0.1s;
    position: relative;
  }
  .si-preorder-full-page .hero-eyebrow::before,
  .si-preorder-full-page .hero-eyebrow::after {
    content: '';
    display: inline-block;
    width: 30px;
    height: 1px;
    background: var(--gold);
    opacity: 0.6;
  }

  .si-preorder-full-page .hero-tag {
    font-size: 9.6px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--cream);
    background: var(--burg);
    padding: 5px 16px;
    margin-bottom: 24px;
    display: inline-block;
    animation: fadeUp 0.9s ease both 0s;
    position: relative;
  }

  .si-preorder-full-page .hero-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(57.6px, 7vw, 104px);
    font-weight: 300;
    line-height: 1.02;
    color: var(--burg-dk);
    margin-bottom: 8px;
    animation: fadeUp 1s ease both 0.22s;
    position: relative;
    letter-spacing: -0.01em;
  }
  .si-preorder-full-page .hero-title em {
    font-style: italic;
    font-weight: 400;
    color: var(--burg);
  }
  .si-preorder-full-page .hero-title .tm {
    font-family: 'Jost', sans-serif;
    font-size: 0.28em;
    vertical-align: super;
    letter-spacing: 0.1em;
    font-weight: 400;
    color: var(--gold);
  }

  .si-preorder-full-page .hero-subtitle {
    font-family: 'EB Garamond', serif;
    font-size: clamp(16px, 1.8vw, 20.8px);
    font-style: italic;
    color: var(--muted);
    max-width: 560px;
    margin: 0 auto 42px;
    line-height: 1.8;
    animation: fadeUp 1s ease both 0.36s;
    position: relative;
  }

  .si-preorder-full-page .hero-cta-group {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
    animation: fadeUp 1s ease both 0.5s;
    position: relative;
  }

  /* scroll indicator */
  .si-preorder-full-page .scroll-hint {
    position: absolute;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    animation: fadeUp 1s ease both 1.2s;
    color: var(--muted-lt);
  }
  .si-preorder-full-page .scroll-hint span {
    font-size: 9.28px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  .si-preorder-full-page .scroll-line {
    width: 1px;
    height: 40px;
    background: linear-gradient(to bottom, var(--gold), transparent);
    animation: scrollPulse 2s ease-in-out infinite;
  }
  @keyframes scrollPulse {
    0%,
    100% {
      opacity: 0.4;
      transform: scaleY(1);
    }
    50% {
      opacity: 0.9;
      transform: scaleY(1.15);
    }
  }

  /* ═══════════════════════════════════════════
   WAVY DIVIDER
═══════════════════════════════════════════ */
  .si-preorder-full-page .wave-div {
    position: relative;
    height: 80px;
    overflow: hidden;
    background: var(--burg-dk);
  }
  .si-preorder-full-page .wave-div svg {
    position: absolute;
    bottom: 0;
    width: 100%;
  }
  .si-preorder-full-page .wave-div.light {
    background: var(--cream);
  }
  .si-preorder-full-page .wave-div.light svg path {
    fill: var(--cream-dk);
  }
  .si-preorder-full-page .wave-div.dark svg path {
    fill: var(--cream);
  }

  /* ═══════════════════════════════════════════
   HOODIE SHOWCASE — THE STAR SECTION
═══════════════════════════════════════════ */
  .showcase {
    background: var(--cream-dk);
    padding: 90px 80px;
    position: relative;
    z-index: 1;
  }

  /* subtle vignette */
  .showcase::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 60% 80% at 50% 50%, rgba(107, 26, 42, 0.04) 0%, transparent 70%);
    pointer-events: none;
  }

  .showcase-intro {
    text-align: center;
    margin-bottom: 72px;
  }
  .section-eyebrow {
    font-size: 9.92px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--gold);
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-bottom: 16px;
  }
  .section-eyebrow::before,
  .section-eyebrow::after {
    content: '';
    display: inline-block;
    width: 28px;
    height: 1px;
    background: var(--gold);
    opacity: 0.5;
  }

  .section-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(32px, 4vw, 51.2px);
    font-weight: 400;
    color: var(--burg-dk);
    line-height: 1.1;
  }
  .section-title em {
    font-style: italic;
    color: var(--burg);
  }

  /* 4-hoodie grid */
  .hoodie-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    position: relative;
  }

  /* individual hoodie card — THE KEY DESIGN */
  .hoodie-card {
    position: relative;
    cursor: pointer;
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .hoodie-card:hover {
    transform: translateY(-8px);
  }

  /* dreamy atmospheric card background */
  .hoodie-card-inner {
    position: relative;
    border-radius: 2px;
    overflow: hidden;
    background: var(--cream);
  }

  /* the dreamy coloured scene — blends hoodie with atmosphere */
  .hoodie-scene {
    position: relative;
    aspect-ratio: 4/5;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  /* per-genre atmospheric gradient backgrounds */
  .hs-romance {
    background: linear-gradient(160deg, #f8e8ec 0%, #f0d0d8 35%, #e8b8c4 65%, #d89aa8 100%);
  }
  .hs-ya {
    background: linear-gradient(160deg, #e8f4f8 0%, #d0e8f4 35%, #b8dced 65%, #98c8e0 100%);
  }
  .hs-darkrom {
    background: linear-gradient(160deg, #e8e6e4 0%, #d8d4d0 35%, #c8c2bc 65%, #b0a898 100%);
  }
  .hs-fantasy {
    background: linear-gradient(160deg, #ede8f8 0%, #ddd0f0 35%, #ccc0e8 65%, #b4a0d8 100%);
  }

  /* hoodie visual — oversized centred shape */
  .hoodie-visual {
    position: relative;
    z-index: 2;
    width: 76%;
    margin: 0 auto;
    padding-top: 14%;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .hoodie-card:hover .hoodie-visual {
    transform: scale(1.04) translateY(-4px);
  }

  .hoodie-svg {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 12px 32px rgba(26, 8, 14, 0.18));
  }

  /* genre-specific hoodie colours */
  .h-pink {
    --hc: #f0b0be;
    --hc2: #e898aa;
    --hc-shadow: rgba(240, 148, 170, 0.35);
    --hc-text: #8b2a40;
  }
  .h-blue {
    --hc: #96c0dc;
    --hc2: #7aaece;
    --hc-shadow: rgba(106, 174, 206, 0.35);
    --hc-text: #2a5a7a;
  }
  .h-grey {
    --hc: #b8b2aa;
    --hc2: #a09890;
    --hc-shadow: rgba(140, 130, 120, 0.35);
    --hc-text: #4a3a30;
  }
  .h-purple {
    --hc: #b898d8;
    --hc2: #a080c8;
    --hc-shadow: rgba(160, 120, 200, 0.35);
    --hc-text: #3a1a5a;
  }

  /* floating particles on scene */
  .sparkle {
    position: absolute;
    border-radius: 50%;
    z-index: 3;
    pointer-events: none;
    animation: sparkleFade ease-in-out infinite;
  }
  @keyframes sparkleFade {
    0%,
    100% {
      opacity: 0;
      transform: scale(0.6) translateY(0);
    }
    50% {
      opacity: 0.7;
      transform: scale(1) translateY(-8px);
    }
  }

  /* card meta below the scene */
  .hoodie-meta {
    padding: 22px 20px 20px;
    background: #fff;
    border: 1px solid var(--cream-wm);
    border-top: none;
  }

  .genre-tag {
    font-size: 9.28px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 700;
    display: inline-block;
    padding: 3px 10px;
    margin-bottom: 10px;
  }
  .gt-romance {
    background: #fde8ed;
    color: #8b2a40;
  }
  .gt-ya {
    background: #e0f0f8;
    color: #1a5070;
  }
  .gt-darkrom {
    background: #ece8e6;
    color: #3a2a1a;
  }
  .gt-fantasy {
    background: #ede0f8;
    color: #3a1a60;
  }

  .hoodie-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 19.2px;
    font-weight: 500;
    color: var(--burg-dk);
    line-height: 1.25;
    margin-bottom: 4px;
  }
  .hoodie-tagline {
    font-family: 'EB Garamond', serif;
    font-size: 14.08px;
    font-style: italic;
    color: var(--muted);
    margin-bottom: 14px;
    line-height: 1.5;
  }
  .hoodie-color-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
  }
  .color-swatch {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 1.5px solid rgba(0, 0, 0, 0.1);
    flex-shrink: 0;
  }
  .color-name {
    font-size: 11.52px;
    color: var(--muted);
    font-weight: 300;
  }
  .hoodie-price {
    font-size: 14.4px;
    color: var(--burg);
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .hoodie-cta {
    width: 100%;
    padding: 13px 20px;
    background: transparent;
    border: 1px solid var(--burg);
    color: var(--burg);
    font-family: 'Jost', sans-serif;
    font-size: 10.56px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.25s;
    margin-top: 16px;
    display: block;
    text-align: center;
    text-decoration: none;
  }
  .hoodie-cta:hover {
    background: var(--burg);
    color: var(--cream);
  }

  /* SELECTED state */
  .hoodie-card.selected .hoodie-card-inner {
    outline: 2px solid var(--burg);
    outline-offset: 0px;
  }
  .hoodie-card.selected .hoodie-cta {
    background: var(--burg);
    color: var(--cream);
  }

  /* ═══════════════════════════════════════════
   ORDER FORM / CHECKOUT
═══════════════════════════════════════════ */
  .order-section {
    padding: 90px 80px;
    background: var(--parchment);
    position: relative;
    overflow: hidden;
    z-index: 1;
  }
  .order-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      180deg,
      transparent 0px,
      transparent 31px,
      rgba(184, 146, 74, 0.09) 31px,
      rgba(184, 146, 74, 0.09) 32px
    );
    pointer-events: none;
  }
  /* red margin line */
  .order-section::after {
    content: '';
    position: absolute;
    left: 120px;
    top: 0;
    bottom: 0;
    width: 1px;
    background: rgba(200, 80, 80, 0.12);
    pointer-events: none;
  }

  .order-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
    position: relative;
  }

  /* left — form */
  .order-form-wrap {
  }

  .form-eyebrow {
    font-size: 9.6px;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--gold);
    font-weight: 700;
    margin-bottom: 14px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .form-eyebrow::before {
    content: '';
    display: inline-block;
    width: 24px;
    height: 1px;
    background: var(--gold);
  }

  .form-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 41.6px;
    font-weight: 400;
    color: var(--burg-dk);
    line-height: 1.12;
    margin-bottom: 10px;
  }
  .form-title em {
    font-style: italic;
    color: var(--burg);
  }

  .form-subtitle {
    font-family: 'EB Garamond', serif;
    font-size: 16px;
    font-style: italic;
    color: var(--muted);
    margin-bottom: 36px;
    line-height: 1.7;
  }

  .form-select-label {
    font-size: 10.56px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 600;
    display: block;
    margin-bottom: 10px;
  }

  .genre-select-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-bottom: 28px;
  }
  .genre-option {
    border: 1px solid var(--cream-wm);
    background: #fff;
    padding: 14px 16px;
    cursor: pointer;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    gap: 12px;
    position: relative;
  }
  .genre-option:hover {
    border-color: var(--burg-soft);
  }
  .genre-option.active {
    border-color: var(--burg);
    background: var(--burg-xs);
  }
  .genre-dot {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    flex-shrink: 0;
    border: 1.5px solid rgba(0, 0, 0, 0.1);
  }
  .go-romance .genre-dot {
    background: var(--pink-hoodie);
  }
  .go-ya .genre-dot {
    background: var(--blue-hoodie);
  }
  .go-darkrom .genre-dot {
    background: var(--grey-hoodie);
  }
  .go-fantasy .genre-dot {
    background: var(--purple-hoodie);
  }
  .genre-option-name {
    font-size: 12.48px;
    font-weight: 500;
    color: var(--burg-dk);
  }
  .genre-option-sub {
    font-size: 10.56px;
    color: var(--muted);
    font-weight: 300;
  }
  .go-check {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--burg);
    display: none;
    align-items: center;
    justify-content: center;
  }
  .go-check svg {
    width: 10px;
    height: 10px;
  }
  .genre-option.active .go-check {
    display: flex;
  }

  .size-row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }
  .size-btn {
    width: 44px;
    height: 44px;
    border: 1px solid var(--cream-wm);
    background: #fff;
    font-family: 'Jost', sans-serif;
    font-size: 11.84px;
    font-weight: 500;
    color: var(--muted);
    cursor: pointer;
    transition: all 0.2s;
  }
  .size-btn:hover {
    border-color: var(--burg-soft);
    color: var(--burg);
  }
  .size-btn.active {
    border-color: var(--burg);
    background: var(--burg);
    color: var(--cream);
  }

  .form-note {
    background: rgba(107, 26, 42, 0.05);
    border-left: 3px solid var(--burg-soft);
    padding: 14px 18px;
    margin-bottom: 28px;
    font-size: 13.12px;
    color: var(--muted);
    line-height: 1.65;
    font-style: italic;
  }

  .btn-primary {
    width: 100%;
    padding: 18px 36px;
    background: var(--burg);
    color: var(--cream);
    font-family: 'Jost', sans-serif;
    font-size: 11.52px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 600;
    border: none;
    cursor: pointer;
    transition: all 0.25s;
    position: relative;
    overflow: hidden;
  }
  .btn-primary::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--burg-lt);
    transform: translateX(-100%);
    transition: transform 0.3s ease;
  }
  .btn-primary:hover::before {
    transform: translateX(0);
  }
  .btn-primary span {
    position: relative;
    z-index: 1;
  }

  .secure-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
    justify-content: center;
  }
  .secure-row span {
    font-size: 10.88px;
    color: var(--muted-lt);
    letter-spacing: 0.08em;
  }

  /* right — order summary */
  .order-summary {
  }
  .summary-card {
    background: #fff;
    border: 1px solid var(--cream-wm);
    padding: 36px;
    position: sticky;
    top: 90px;
  }
  .summary-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 22.4px;
    font-weight: 500;
    color: var(--burg-dk);
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--cream-wm);
  }
  .summary-item {
    display: flex;
    justify-content: space-between;
    align-items: start;
    padding: 14px 0;
    border-bottom: 1px solid var(--cream-wm);
    gap: 20px;
  }
  .summary-item:last-of-type {
    border-bottom: none;
  }
  .si-left {
    flex: 1;
  }
  .si-name {
    font-size: 14.08px;
    font-weight: 500;
    color: var(--burg-dk);
    margin-bottom: 4px;
  }
  .si-detail {
    font-size: 12px;
    color: var(--muted);
    font-weight: 300;
  }
  .si-price {
    font-size: 14.08px;
    font-weight: 600;
    color: var(--burg);
    white-space: nowrap;
  }
  .summary-total {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 18px;
    margin-top: 4px;
    border-top: 1.5px solid var(--burg-dk);
  }
  .st-label {
    font-family: 'Cormorant Garamond', serif;
    font-size: 17.6px;
    font-weight: 500;
    color: var(--burg-dk);
  }
  .st-amount {
    font-family: 'Cormorant Garamond', serif;
    font-size: 22.4px;
    font-weight: 600;
    color: var(--burg);
  }
  .summary-perks {
    margin-top: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .perk-row {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12.48px;
    color: var(--muted);
    font-weight: 300;
  }
  .perk-icon {
    color: var(--gold);
    font-size: 14.4px;
    flex-shrink: 0;
  }

  /* ═══════════════════════════════════════════
   ABOUT HOODIES SECTION
═══════════════════════════════════════════ */
  .about-product {
    padding: 100px 80px;
    background: var(--burg-dk);
    position: relative;
    overflow: hidden;
    z-index: 1;
  }
  .about-product::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      180deg,
      transparent 0px,
      transparent 33px,
      rgba(255, 255, 255, 0.022) 33px,
      rgba(255, 255, 255, 0.022) 34px
    );
    pointer-events: none;
  }
  .ap-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }
  .ap-badges {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 22px;
  }
  .ap-badge {
    border: 1px solid rgba(184, 146, 74, 0.4);
    color: var(--gold-lt);
    font-size: 9.28px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 4px 14px;
    font-weight: 600;
  }
  .ap-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(35.2px, 3.5vw, 51.2px);
    font-weight: 400;
    color: #e8c4b0 !important;
    line-height: 1.12;
    margin-bottom: 10px;
  }
  .ap-title em {
    font-style: italic;
    color: #e8c4b0;
  }
  .ap-series {
    font-family: 'EB Garamond', serif;
    font-size: 16px;
    font-style: italic;
    color: rgba(250, 246, 237, 0.55);
    margin-bottom: 28px;
  }
  .ap-desc {
    color: rgba(250, 246, 237, 0.65);
    font-size: 14.72px;
    line-height: 1.9;
    font-weight: 300;
    margin-bottom: 32px;
  }
  .feature-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 36px;
  }
  .feature-item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }
  .feat-dot {
    width: 6px;
    height: 6px;
    background: var(--gold);
    border-radius: 50%;
    flex-shrink: 0;
    margin-top: 6px;
  }
  .feat-text {
    font-size: 14.08px;
    color: rgba(250, 246, 237, 0.75);
    line-height: 1.55;
    font-weight: 300;
  }
  .feat-text b {
    color: var(--cream);
    font-weight: 500;
  }

  /* stacked dreamy hoodie display */
  .hoodie-stack {
    position: relative;
    height: 380px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hs-card {
    position: absolute;
    width: 200px;
    border-radius: 2px;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
    transition: transform 0.4s ease;
  }
  .hs-card:hover {
    transform: var(--hover-t) !important;
    z-index: 10;
  }
  .hs-card-1 {
    transform: rotate(-8deg) translate(-90px, 20px);
    --hover-t: rotate(-4deg) translate(-85px, 10px) scale(1.05);
    z-index: 1;
  }
  .hs-card-2 {
    transform: rotate(-2deg) translate(-30px, -15px);
    --hover-t: rotate(0deg) translate(-28px, -25px) scale(1.06);
    z-index: 2;
  }
  .hs-card-3 {
    transform: rotate(4deg) translate(40px, 10px);
    --hover-t: rotate(2deg) translate(42px, 0px) scale(1.05);
    z-index: 3;
  }
  .hs-card-4 {
    transform: rotate(10deg) translate(100px, 25px);
    --hover-t: rotate(6deg) translate(95px, 15px) scale(1.05);
    z-index: 4;
  }
  .hs-inner {
    aspect-ratio: 3/4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }
  .hs-inner::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 30%, rgba(255, 255, 255, 0.3), transparent 70%);
  }
  .hs-inner svg {
    width: 75%;
    z-index: 1;
    filter: drop-shadow(0 8px 20px rgba(26, 8, 14, 0.25));
  }
  .hsc-1 {
    background: linear-gradient(155deg, #f5d0d8, #e8a8b8);
  }
  .hsc-2 {
    background: linear-gradient(155deg, #cce4f4, #a0c8e8);
  }
  .hsc-3 {
    background: linear-gradient(155deg, #e0dbd6, #c0b8b0);
  }
  .hsc-4 {
    background: linear-gradient(155deg, #e0d0f0, #c0a8e0);
  }

  /* ═══════════════════════════════════════════
   GALLERY STRIP
═══════════════════════════════════════════ */
  .gallery-strip {
    padding: 90px 80px;
    background: var(--cream);
    position: relative;
    z-index: 1;
  }
  .gallery-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 2fr;
    grid-template-rows: 260px;
    gap: 8px;
    margin-top: 50px;
  }
  .gal-tile {
    overflow: hidden;
    position: relative;
    cursor: pointer;
  }
  .gal-tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transition: transform 0.5s ease;
  }
  .gal-tile:hover img {
    transform: scale(1.06);
  }
  .gal-tile .gal-overlay {
    position: absolute;
    inset: 0;
    background: rgba(74, 15, 28, 0);
    transition: background 0.3s;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .gal-tile:hover .gal-overlay {
    background: rgba(74, 15, 28, 0.3);
  }
  .gal-icon {
    color: var(--cream);
    font-size: 24px;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .gal-tile:hover .gal-icon {
    opacity: 1;
  }
  /* placeholder colours */
  .gc-1 {
    background: linear-gradient(145deg, #e8c0c8, #c09098);
  }
  .gc-2 {
    background: linear-gradient(145deg, #c0d8e8, #8aacca);
  }
  .gc-3 {
    background: linear-gradient(145deg, #d8d0c8, #a09088);
  }
  .gc-4 {
    background: linear-gradient(145deg, #d0c0e8, #a090c8);
  }
  .gal-ph {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 56px;
    opacity: 0.35;
  }

  /* ═══════════════════════════════════════════
   BOTTOM CTA / NEWSLETTER
═══════════════════════════════════════════ */
  .bottom-cta {
    padding: 90px 80px;
    background: var(--burg);
    text-align: center;
    position: relative;
    overflow: hidden;
    z-index: 1;
  }
  .bottom-cta::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      180deg,
      transparent 0px,
      transparent 33px,
      rgba(255, 255, 255, 0.04) 33px,
      rgba(255, 255, 255, 0.04) 34px
    );
    pointer-events: none;
  }
  .bottom-cta::after {
    content: '📖';
    position: absolute;
    font-size: 352px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    opacity: 0.03;
    pointer-events: none;
  }
  .bc-eyebrow {
    color: var(--gold-lt);
    font-size: 9.92px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    font-weight: 600;
    display: block;
    margin-bottom: 16px;
    position: relative;
  }
  .bc-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(32px, 4vw, 51.2px);
    font-weight: 400;
    color: var(--cream);
    margin-bottom: 16px;
    position: relative;
  }
  .bc-title em {
    font-style: italic;
  }
  .bc-desc {
    color: rgba(250, 246, 237, 0.65);
    font-size: 14.88px;
    font-weight: 300;
    max-width: 440px;
    margin: 0 auto 38px;
    line-height: 1.8;
    position: relative;
  }
  .nl-form {
    display: flex;
    max-width: 400px;
    margin: 0 auto;
    position: relative;
  }
  .nl-input {
    flex: 1;
    padding: 15px 20px;
    font-family: 'Jost', sans-serif;
    font-size: 13.44px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.1);
    color: var(--cream);
    outline: none;
    letter-spacing: 0.04em;
  }
  .nl-input::placeholder {
    color: rgba(250, 246, 237, 0.35);
  }
  .nl-btn {
    padding: 15px 26px;
    background: var(--gold);
    color: var(--burg-dk);
    font-family: 'Jost', sans-serif;
    font-size: 10.72px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 700;
    border: none;
    cursor: pointer;
    transition: background 0.2s;
  }
  .nl-btn:hover {
    background: var(--gold-lt);
  }

  /* ═══════════════════════════════════════════
   SHARED ANIMATIONS
═══════════════════════════════════════════ */
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(26px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* scrollbar */
  ::-webkit-scrollbar {
    width: 4px;
  }
  ::-webkit-scrollbar-track {
    background: var(--cream);
  }
  ::-webkit-scrollbar-thumb {
    background: var(--burg);
  }

  /* Shopify containment: keep imported HTML from changing the theme header/footer. */
  .si-preorder-full-page {
    display: block;
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
    font-size: 16px;
    line-height: normal;
    letter-spacing: normal;
    font-family: 'Jost', sans-serif;
    background: var(--cream);
    color: var(--ink);
    overflow-x: hidden;
    min-height: 100vh;
    position: relative;
  }
  body:has(.si-preorder-full-page) #MainContent {
    display: block;
    padding: 0;
    margin: 0;
    width: 100%;
  }
  body:has(.si-preorder-full-page) #MainContent > .shopify-section {
    margin: 0;
  }

  /* ── success modal ── */
  .modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0, 0, 0, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease;
  }
  .modal-overlay.open {
    opacity: 1;
    pointer-events: all;
  }
  .modal-box {
    background: #faf6ed;
    border-radius: 20px;
    padding: 44px 40px 36px;
    max-width: 400px;
    width: 90%;
    text-align: center;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.18);
    transform: translateY(20px);
    transition: transform 0.35s ease;
  }
  .modal-overlay.open .modal-box {
    transform: translateY(0);
  }
  .modal-icon {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #6b1a2a;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 16px;
  }
  .modal-icon svg {
    width: 26px;
    height: 26px;
  }
  .modal-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 22px;
    font-weight: 600;
    color: #3a2a1a;
    margin: 0 0 6px;
  }
  .modal-product {
    font-family: 'Jost', sans-serif;
    font-size: 14px;
    color: #6b1a2a;
    margin: 0 0 2px;
    letter-spacing: 0.02em;
  }
  .modal-size {
    font-family: 'Jost', sans-serif;
    font-size: 13px;
    color: #8b6e5a;
    margin: 0 0 24px;
  }
  .modal-actions {
    display: flex;
    gap: 10px;
    justify-content: center;
  }
  .modal-btn {
    padding: 11px 28px;
    border-radius: 40px;
    font-family: 'Jost', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    border: none;
    transition: all 0.25s;
    text-decoration: none;
    display: inline-block;
  }
  .modal-btn-primary {
    background: #6b1a2a;
    color: #faf6ed;
  }
  .modal-btn-primary:hover {
    background: #4a0f1c;
  }
  .modal-btn-ghost {
    background: transparent;
    color: #6b1a2a;
    border: 1px solid #6b1a2a;
  }
  .modal-btn-ghost:hover {
    background: #6b1a2a;
    color: #faf6ed;
  }
  .btn-primary.loading {
    opacity: 0.55;
    cursor: wait;
  }
  .btn-primary.loading span::after {
    content: '';
    display: inline-block;
    width: 14px;
    height: 14px;
    margin-left: 8px;
    border: 2px solid transparent;
    border-top-color: currentColor;
    border-radius: 50%;
    animation: spin 0.6s linear infinite;
    vertical-align: middle;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* ═══════════════════════════════════════════
   RESPONSIVE DESIGN
═══════════════════════════════════════════ */
  @media screen and (max-width: 1100px) {
    .hoodie-grid,
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .order-grid,
    .ap-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .gallery-grid {
      grid-template-rows: auto;
    }
    .gal-tile {
      min-height: 260px;
    }
    .showcase,
    .order-section,
    .about-product,
    .gallery-strip,
    .bottom-cta {
      padding: 72px 32px;
    }
    .summary-card {
      position: relative;
      top: auto;
    }
    .order-section::after {
      display: none;
    }
  }

  @media screen and (max-width: 767px) {
    .si-preorder-full-page .hero {
      min-height: auto;
      padding: 100px 20px 80px;
    }
    .si-preorder-full-page .hero-title {
      font-size: clamp(42px, 11vw, 56px);
    }
    .gallery-grid,
    .genre-select-grid {
      grid-template-columns: 1fr;
    }
    .hoodie-grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 16px;
      padding-bottom: 24px;
      margin-left: -24px;
      margin-right: -24px;
      padding-left: 24px;
      padding-right: 24px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .hoodie-grid::-webkit-scrollbar {
      display: none;
    }
    .hoodie-card {
      flex: 0 0 85%;
      scroll-snap-align: center;
    }
    .showcase,
    .order-section,
    .about-product,
    .gallery-strip,
    .bottom-cta {
      padding: 60px 24px;
    }
    .hoodie-stack {
      height: 380px;
      overflow: hidden;
    }
    .hs-card {
      width: 160px;
    }
    .hs-card-1 {
      transform: rotate(-8deg) translate(-50px, 20px);
      --hover-t: rotate(-4deg) translate(-45px, 10px) scale(1.05);
    }
    .hs-card-2 {
      transform: rotate(-2deg) translate(-15px, -15px);
      --hover-t: rotate(0deg) translate(-13px, -25px) scale(1.06);
    }
    .hs-card-3 {
      transform: rotate(4deg) translate(20px, 10px);
      --hover-t: rotate(2deg) translate(22px, 0px) scale(1.05);
    }
    .hs-card-4 {
      transform: rotate(10deg) translate(50px, 25px);
      --hover-t: rotate(6deg) translate(45px, 15px) scale(1.05);
    }
    .nl-form {
      flex-direction: column;
      width: 100%;
    }
    .nl-btn {
      width: 100%;
    }
    .summary-card {
      padding: 24px;
    }
    .hero-cta-group {
      flex-direction: column;
      width: 100%;
      padding: 0 16px;
    }
    .hero-cta-group > a {
      width: 100%;
      box-sizing: border-box;
    }
  }
{%- endstyle -%}

<div class='si-preorder-full-page'>
  {%- assign hoodie_collection = collections['bookish-hoodies'] -%}
  {%- assign products = hoodie_collection.products -%}
  {%- assign genre_keys = 'romance,ya,darkrom,fantasy' | split: ',' -%}
  {%- assign genre_labels = 'Romance,Young Adult,Dark Romance,Fantasy' | split: ',' -%}
  {%- assign genre_taglines = 'For the hopeless romantic on every page,For the dreamer who grew up in pages,For the reader who likes their love complicated,For those who belong between the worlds'
    | split: ','
  -%}
  {%- assign h_classes = 'h-pink,h-blue,h-grey,h-purple' | split: ',' -%}
  {%- assign hs_classes = 'hs-romance,hs-ya,hs-darkrom,hs-fantasy' | split: ',' -%}
  {%- assign gt_classes = 'gt-romance,gt-ya,gt-darkrom,gt-fantasy' | split: ',' -%}
  {%- assign sparkle_set = '#e898aa,#7aaece,#a09890,#a080c8' | split: ',' -%}
  {%- assign color_swatches = '#f0b0be,#96c0dc,#b8b2aa,#b898d8' | split: ',' -%}
  {%- assign color_labels = 'Dusty Pink,Baby Blue,Titanium Grey,Deep Purple' | split: ',' -%}
  {%- assign static_titles = 'Heart Full,Raised On Stories,Soft Heart Dark Desires,Lost in Realms' | split: ',' -%}
  {%- assign hsc_classes = 'hsc-1,hsc-2,hsc-3,hsc-4' | split: ',' -%}
  {%- assign gc_classes = 'gc-1,gc-2,gc-3,gc-4' | split: ',' -%}
  {%- assign static_gallery = '👕,📚,☕,🌿' | split: ',' -%}

  <!-- ══════════ HERO ══════════ -->
  <section class='hero'>
    <!-- dreamy orbs -->
    <div class='orb orb-1'></div>
    <div class='orb orb-2'></div>
    <div class='orb orb-3'></div>

    <!-- floating page SVGs (spawned by JS) -->
    <div id='fp-container'></div>

    <div class='hero-tag'>Now Open for Pre-order</div>
    <p class='hero-eyebrow'>Wear Your Story™</p>
    <h1 class='hero-title'>
      Oversized Bookish<br>
      <em>Hoodies</em><span class='tm'>™</span>
    </h1>
    <p class='hero-subtitle'>
      Premium puff-print hoodies designed for modern readers who want comfort without compromising style. Because your
      story doesn't stop at the page.
    </p>
    <div class='hero-cta-group'>
      <a href='#choose' class='btn-primary'><span>Choose Your Genre →</span></a>
      <a
        href='#about'
        class='btn-ghost'
        style="padding:14px 32px;display:inline-block;border:1px solid var(--burg);color:var(--burg);font-family:'Jost',sans-serif;font-size:11.52px;letter-spacing:.18em;text-transform:uppercase;font-weight:600;text-decoration:none;transition:all .25s;"
        onmouseover="this.style.background='var(--burg)';this.style.color='var(--cream)'"
        onmouseout="this.style.background='transparent';this.style.color='var(--burg)'"
        >Learn More</a
      >
    </div>

    <div class='scroll-hint'>
      <span>Scroll to explore</span>
      <div class='scroll-line'></div>
    </div>
  </section>

  <!-- wavy divider -->
  <div style='height:60px;background:var(--cream);position:relative;overflow:hidden;'>
    <svg
      viewBox='0 0 1440 60'
      preserveAspectRatio='none'
      style='position:absolute;top:0;width:100%;height:100%'
      xmlns='http://www.w3.org/2000/svg'
    >
      <path d="M0,0 Q360,60 720,30 Q1080,0 1440,50 L1440,0 Z" fill="#f0e8d8"/>
    </svg>
  </div>

  <!-- ══════════ HOODIE SHOWCASE ══════════ -->
  <section class='showcase' id='choose'>
    <div class='showcase-intro'>
      <div class='section-eyebrow'>Four Genres. One Perfect Hoodie.</div>
