{% comment %} Custom Blog Section for Shelf Indulgence {% endcomment %}
{%- style -%}
  .si-blog {
    padding-top: 80px;
    padding-bottom: 80px;
    color: #0f181f;
    font-family: var(--font-body-family);
  }
  .si-blog__heading {
    font-size: 48px;
    margin-bottom: 60px;
    text-transform: capitalize;
    font-weight: 300;
    letter-spacing: -0.02em;
  }
  .si-blog__container {
    display: flex;
    gap: 60px;
    align-items: stretch;
  }
  .si-blog__image-col {
    flex: 1;
    max-width: 100%;
    overflow: hidden;
    border-radius: 12px;
  }
  .si-blog__image-col img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  .si-blog__image-col:hover img {
    transform: scale(1.05);
  }
  .si-blog__content-col {
    flex: 1;
    padding-top: 10px;
    display: flex;
    flex-direction: column;
  }
  .si-blog__author-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 24px;
  }
  .si-blog__author-info {
    display: flex;
    flex-direction: column;
  }
  .si-blog__author-image {
    width: 48px;
    height: 48px;
    object-fit: contain;
    border-radius: 50%;
  }
  .si-blog__author-name {
    font-size: 16px;
    font-weight: 500;
    color: #0f181f;
    line-height: 1.2;
  }
  .si-blog__date {
    font-size: 14px;
    opacity: 0.6;
    display: block;
    font-weight: 400;
    line-height: 1.2;
  }
  .si-blog__title {
    font-size: 22px;
    line-height: 1.4;
    margin: 0 0 16px 0;
    color: #0f181f;
    font-weight: 600 !important;
    cursor: pointer;
    transition: opacity 0.3s ease;
  }
  .si-blog__title:hover {
    opacity: 0.7;
  }
  .si-blog__excerpt {
    font-size: 14px;
    line-height: 1.8;
    margin-bottom: 32px;
    color: #0f181f;
    opacity: 0.9;
  }
  .si-blog__meta {
    display: flex;
    align-items: center;
    gap: 24px;
    font-size: 13px;
    font-weight: 500;
    color: #0f181f;
    margin-top: auto;
  }
  .si-blog__meta-item {
    display: flex;
    align-items: center;
    gap: 8px;
    opacity: 0.7;
  }
  .si-blog__meta-item:last-child {
    margin-left: auto;
  }
  .si-blog__icon-heart {
    width: 18px;
    height: 18px;
    color: #0f181f;
  }

  @media screen and (max-width: 989px) {
    .si-blog__container {
      gap: 30px;
    }
  }

  @media screen and (max-width: 749px) {
    .si-blog {
      padding-top: 40px;
      padding-bottom: 40px;
    }
    .si-blog__heading {
      font-size: 36px;
      margin-bottom: 30px;
    }
    .si-blog__container {
      flex-direction: column;
      gap: 30px;
    }
    .si-blog__image-col {
      flex: 0 0 auto;
      max-width: 100%;
      width: 100%;
    }
  }
  .si-blog__link {
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .si-blog__link:hover {
    text-decoration: none;
    color: inherit;
  }
{%- endstyle -%}

<div class="si-blog page-width">
  <h1 class="si-blog__heading">Blog</h1>

  <div class="si-blog__container">
    <div class="si-blog__image-col">
      <a href="/blogs/where-our-storytelling-begins-the-origins-of-imagination-and-identity">
        <img src="{{ 'two-young-children.jpg' | asset_url }}" alt="Two young children" loading="lazy">
      </a>
    </div>
    <div class="si-blog__content-col">
      <div class="si-blog__author-row">
        <img src="{{ 'shelf-indulgence.png' | asset_url }}" alt="Jessie Fry" class="si-blog__author-image" width="48" height="48" loading="lazy">
        <div class="si-blog__author-info">
          <span class="si-blog__author-name">Jessie Fry</span>
          <span class="si-blog__date">Mar 1</span>
        </div>
      </div>
      
      <a href="/blogs/where-our-storytelling-begins-the-origins-of-imagination-and-identity" class="si-blog__link">
        <h2 class="si-blog__title">Where Our Storytelling Begins: The Origins of Imagination and Identity</h2>
      </a>
      
      <a href="/blogs/where-our-storytelling-begins-the-origins-of-imagination-and-identity" class="si-blog__link">
        <p class="si-blog__excerpt">
          Before I ever called myself a writer, I was already telling stories. The truth is, we all are. Storytelling doesn’t begin with a notebook, a keyboard, or even a full sentence. It begins much
        </p>
      </a>

      <div class="si-blog__meta">
        <span class="si-blog__meta-item">0 views</span>
        <span class="si-blog__meta-item">0 comments</span>
        <span class="si-blog__meta-item">
          {% render 'icon-heart' %}
        </span>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SI Blog Custom",
  "settings": [],
  "presets": [
    {
      "name": "SI Blog Custom"
    }
  ]
}
{% endschema %}
