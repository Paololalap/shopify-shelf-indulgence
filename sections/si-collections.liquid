<style>
  .si-coll-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--si-cream-dark);
    max-width: 978px;
    margin: 0 auto;
  }
  .si-coll-tile {
    background: var(--si-cream);
    padding: 50px 2.5rem;
    position: relative;
    overflow: hidden;
    transition: background 0.3s;
    text-decoration: none;
    display: block;
    text-align: left;
  }

  .si-coll-tile--alt {
    background: var(--si-burg-faint);
  }
  .si-coll-tile--disabled {
    cursor: default;
  }
  .si-coll-tile-num {
    font-family: var(--si-serif);
    font-size: calc(4rem + 10px);
    color: var(--si-cream-dark);
    font-weight: 300;
    position: absolute;
    top: -0.5rem;
    right: 1rem;
    line-height: 1;
    z-index: 0;
  }
  .si-coll-tile-inner {
    position: relative;
    z-index: 1;
  }
  .si-coll-tile-cat {
    font-size: calc(0.6rem + 10px);
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--si-gold);
    margin-bottom: 0.6rem;
    font-weight: 400;
    font-family: var(--si-sans);
  }
  .si-coll-tile-name {
    font-family: var(--si-serif);
    font-size: calc(1.5rem + 10px);
    color: var(--si-burg-deep);
    font-weight: 400;
    margin: 0;
  }
  .si-coll-tile-desc {
    font-size: calc(0.78rem + 10px);
    line-height: 1.8;
    color: var(--si-text-mid);
    font-weight: 300;
    margin-bottom: 1.2rem;
    font-family: var(--si-sans);
  }
  @media screen and (max-width: 749px) {
    .si-coll-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class='si-coll-grid'>
  {% for block in section.blocks %}
    {%- liquid
      assign tile_collection = block.settings.collection
      assign has_products = false
      if tile_collection != blank and tile_collection.all_products_count > 0
        assign has_products = true
      endif

      if tile_collection != blank
        assign tile_url = tile_collection.url
        assign tile_title = block.settings.title | default: tile_collection.title
      else
        assign tile_url = block.settings.link
        assign tile_title = block.settings.title
      endif
    -%}
    
    {%- if has_products -%}
      <a
        href='{{ tile_url }}'
        class='si-coll-tile{% if block.settings.alt_bg %} si-coll-tile--alt{% endif %}'
        {{ block.shopify_attributes }}
      >
    {%- else -%}
      <div
        class='si-coll-tile{% if block.settings.alt_bg %} si-coll-tile--alt{% endif %} si-coll-tile--disabled'
        {{ block.shopify_attributes }}
      >
    {%- endif -%}

      <div class='si-coll-tile-inner'>
        {% if block.settings.category != blank %}
          <p class='si-coll-tile-cat'>{{ block.settings.category }}</p>
        {% endif %}
        {% if tile_title != blank %}
          <p class='si-coll-tile-name'>{{ tile_title }}</p>
        {% endif %}
        {% if block.settings.description != blank %}
          <p class='si-coll-tile-desc'>{{ block.settings.description }}</p>
        {% endif %}
      </div>

    {%- if has_products -%}
      </a>
    {%- else -%}
      </div>
    {%- endif -%}
  {% endfor %}
</div>

{% schema %}
{
  "name": "SI Collections",
  "settings": [],
  "blocks": [
    {
      "type": "tile",
      "name": "Collection Tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "category", "label": "Category" },
        { "type": "text", "id": "title", "label": "Title override", "info": "Leave blank to use the collection title" },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        { "type": "url", "id": "link", "label": "Link (fallback if no collection chosen)" },
        { "type": "checkbox", "id": "alt_bg", "label": "Alternate background", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "SI Collections",
      "blocks": [
        {
          "type": "tile",
          "settings": {
            "category": "Mystery box",
            "title": "A Novel Encounter"
          }
        }
      ]
    }
  ]
}
{% endschema %}
