<style>
  /* ── Everflow Promo Section ───────────────── */
  .si-everflow-promo {
    background-color: #fcf9e2;
    padding: 80px 40px;
  }

  .si-everflow-promo__inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 80% 20%;
    align-items: center;
  }

  /* ── Column 1 – Text (80%) ────────────────── */
  .si-everflow-promo__text {
    grid-column: 1;
    grid-row: 1;
    align-self: end;
    padding-bottom: 20px;
  }

  .si-everflow-promo__title {
    font-family: var(--si-serif);
    font-size: 40px;
    color: #610a1e;
    font-weight: 700 !important;
    margin: 0 0 35px;
    line-height: 1.2;
  }

  .si-everflow-promo__body {
    font-family: var(--si-sans);
    font-size: 15px;
    color: #0f181f;
    font-weight: 400;
    line-height: 1.85;
    margin: 0;
    white-space: pre-line;
  }

  .si-everflow-promo__btn-col {
    grid-column: 1;
    grid-row: 2;
    align-self: start;
    padding-top: 12px;
  }

  .si-everflow-promo__btn {
    display: inline-block;
    background-color: #610a1e;
    color: #fcf9e2;
    font-family: var(--si-sans);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 14px 36px;
    border: none;
    border-radius: 9999px;
    cursor: pointer;
    text-decoration: none;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .si-everflow-promo__btn:hover {
    opacity: 0.88;
    transform: translateY(-1px);
  }

  /* ── Column 2 – Image (20%) ───────────────── */
  .si-everflow-promo__image-col {
    grid-column: 2;
    grid-row: 1 / span 2;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .si-everflow-promo__img {
    width: 360px;
    height: 375px;
    object-fit: cover;
    border-radius: 8px;
    display: block;
  }

  /* ── Everflow Grid Section ─────────────────── */
  .si-everflow-grid {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(2, 550px);
  }

  .si-everflow-grid__heading {
    grid-column: 1 / -1;
    background-color: #fcf9e2;
    padding: 40px 40px 20px;
    text-align: center;
  }

  .si-everflow-grid__heading h2 {
    font-family: var(--si-serif);
    font-size: 40px;
    color: #610a1e;
    font-weight: 700;
    margin: 0;
  }

  .si-everflow-grid__cell {
    overflow: hidden;
    position: relative;
  }

  .si-everflow-grid__cell--text {
    background-color: #610a1e;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 40px 60px;
  }

  .si-everflow-grid__cell--text h3 {
    font-family: var(--si-serif);
    font-size: 28px;
    color: #fcf9e2 !important;
    font-weight: 700 !important;
    margin: 0 0 35px;
    line-height: 1.25;
  }

  .si-everflow-grid__cell--text p {
    font-family: var(--si-sans);
    font-size: 15px;
    color: #fcf9e2;
    font-weight: 400;
    line-height: 1.7;
    margin: 0 0 70px;
  }

  .si-everflow-grid__cell--text .si-everflow-grid__cta {
    font-family: var(--si-sans);
    font-size: 15px;
    color: #fcf9e2;
    font-weight: 700;
    margin: 0;
  }

  .si-everflow-grid__cell img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }

  .si-everflow-grid__img--pink-box {
    object-position: center center !important;
  }

  /* ── Responsive ────────────────────────────── */
  @media screen and (max-width: 980px) {
    .si-everflow-promo__inner {
      grid-template-columns: 1fr 300px;
      gap: 30px;
    }
    .si-everflow-promo__img {
      width: 300px;
      height: 312px;
    }
  }

  @media screen and (max-width: 749px) {
    .si-everflow-promo {
      padding: 50px 20px;
    }

    .si-everflow-promo__inner {
      display: flex;
      flex-direction: column;
      gap: 20px;
      text-align: center;
    }

    .si-everflow-promo__text {
      padding-bottom: 0;
    }

    .si-everflow-promo__title {
      font-size: 28px;
    }

    .si-everflow-promo__image-col {
      order: 2; /* Image comes after text */
    }

    .si-everflow-promo__btn-col {
      order: 3; /* Button comes after image */
      padding-top: 10px;
      margin-left: auto;
      margin-right: auto;
    }

    .si-everflow-promo__img {
      width: 280px;
      height: 292px;
    }

    .si-everflow-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: repeat(4, 539px);
    }
  }

  @media screen and (max-width: 480px) {
    .si-everflow-grid {
      grid-template-columns: 1fr;
      grid-template-rows: repeat(8, auto);
    }

    .si-everflow-grid__cell--text {
      padding: 32px 20px;
    }

    .si-everflow-grid__cell img {
      height: 300px;
    }

    /* Swap order on mobile for consistent I-T pattern */
    .si-everflow-grid > :nth-child(5) { order: 6; }
    .si-everflow-grid > :nth-child(6) { order: 5; }
    .si-everflow-grid > :nth-child(7) { order: 8; }
    .si-everflow-grid > :nth-child(8) { order: 7; }
  }
</style>

<section class="si-everflow-promo">
  <div class="si-everflow-promo__inner">

    <!-- ── Text Block ──────────────────────── -->
    <div class="si-everflow-promo__text">
      <h2 class="si-everflow-promo__title">Everflow &mdash; The Balance-Born Saga &mdash; Year 1</h2>

      <p class="si-everflow-promo__body">Four students.
Four elements.
One fragile balance.
Everflow was meant to train them.
Instead, it might destroy them.
Because when the elements awaken…
the truth rises with them.</p>
    </div>

    <!-- ── Image Block ─────────────────────── -->
    <div class="si-everflow-promo__image-col">
      <img
        src="{{ 'coming-soon-jessie-heart.png' | asset_url }}"
        alt="Everflow - The Balance-Born Saga - Year 1"
        class="si-everflow-promo__img"
        loading="lazy"
      >
    </div>

    <!-- ── Button Block ────────────────────── -->
    <div class="si-everflow-promo__btn-col">
      <a href="/search?view=everflow" class="si-everflow-promo__btn">Read More</a>
    </div>

  </div>
</section>

<!-- ── Everflow 4×2 Showcase Grid ────────────── -->
<section class="si-everflow-grid">

  <!-- ── Row 1 ──────────────────────────────── -->

  <!-- R1 C1 — Image -->
  <div class="si-everflow-grid__cell">
    <img
      src="{{ 'lost-in-realms-heart-full.jpg' | asset_url }}"
      alt="Lost in Realms – Heart Full"
      loading="lazy"
    >
  </div>

  <!-- R1 C2 — Text -->
  <div class="si-everflow-grid__cell si-everflow-grid__cell--text">
    <h3>Wear Your Story&trade; oversized bookish hoodies</h3>
    <p>Featuring premium puff print detailing for a bold, textured finish, these hoodies blend contemporary design with statement bookish fashion.</p>
    <p class="si-everflow-grid__cta">Curated Choices</p>
  </div>

  <!-- R1 C3 — Image -->
  <div class="si-everflow-grid__cell">
    <img
      src="{{ 'three-books-review-set.jpg' | asset_url }}"
      alt="Three Books Review Set"
      loading="lazy"
    >
  </div>

  <!-- R1 C4 — Text -->
  <div class="si-everflow-grid__cell si-everflow-grid__cell--text">
    <h3>The Reader Necessities</h3>
    <p>Introducing The Reader Necessities &mdash; a new way to indulge in your reading life.<br>Each Pack Includes &ndash; An Australian Designed notepad, memo pad, pen and bookmark.<br>For those that want to blend their love of Reading and Stationary xx</p>
    <p class="si-everflow-grid__cta">Curated Choices</p>
  </div>

  <!-- ── Row 2 ──────────────────────────────── -->

  <!-- R2 C1 — Text -->
  <div class="si-everflow-grid__cell si-everflow-grid__cell--text">
    <h3>Shelf Decor</h3>
    <p>Enhance your space with our enchanting shelf d&eacute;cor. Our range includes whimsical items designed to add character and charm, making every bookshelf not just functional but also a stunning expression of your unique style.</p>
    <p class="si-everflow-grid__cta">Whimsical Touch</p>
  </div>

  <!-- R2 C2 — Image -->
  <div class="si-everflow-grid__cell">
    <img
      src="{{ 'six-colorful-street.jpg' | asset_url }}"
      alt="Six Colorful Street"
      loading="lazy"
    >
  </div>

  <!-- R2 C3 — Text -->
  <div class="si-everflow-grid__cell si-everflow-grid__cell--text">
    <h3>Readers Guilty Pleasures</h3>
    <p>Explore our collection of book-themed merchandise, perfect for book lovers. From apparel to collectibles, we offer fun and practical items that celebrate the love of stories, literature, and creativity.</p>
    <p class="si-everflow-grid__cta">Themed Goods</p>
  </div>

  <!-- R2 C4 — Image -->
  <div class="si-everflow-grid__cell">
    <img
      src="{{ 'a-pink-box.jpg' | asset_url }}"
      alt="A Pink Box"
      class="si-everflow-grid__img--pink-box"
      loading="lazy"
    >
  </div>

</section>

