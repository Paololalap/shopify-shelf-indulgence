<style>
  .si-event-upcoming {
    background-color: #fdf9f4;
  }
  .si-event-upcoming-inner {
    padding: 80px 20px;
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
    font-family: var(--font-body-family);
    color: var(--si-text-color, #0f181f);
  }
  .si-event-h1 {
    font-size: 50px;
    font-weight: 300;
    margin-bottom: 60px;
    line-height: 1.2;
    font-family: var(--font-heading-family);
    color: var(--si-text-color, #0f181f);
  }
  .si-event-date {
    font-size: 18px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-top: 40px;
    margin-bottom: 10px;
    color: #666;
  }
  .si-event-h2 {
    font-size: 50px;
    font-weight: 300;
    margin-bottom: 10px;
    line-height: 1.2;
    font-family: var(--font-heading-family);
    color: var(--si-text-color, #0f181f);
  }
  .si-event-subtitle {
    font-size: 18px;
    margin-bottom: 30px;
    color: #444;
  }
  .si-event-image-row {
    display: flex;
    justify-content: center;
    gap: 21px;
    margin: 40px 0;
    flex-wrap: wrap;
  }
  .si-event-image-row img {
    height: 419px;
    object-fit: cover;
    border-radius: 8px;
    max-width: 100%;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
  }
  .si-event-image-single {
    display: flex;
    justify-content: center;
    margin: 40px 0;
  }
  .si-event-image-single img {
    height: 447px;
    object-fit: cover;
    border-radius: 8px;
    max-width: 100%;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
  }
  .si-event-text {
    font-size: 18px;
    line-height: 1.6;
    margin-bottom: 15px;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
    color: var(--si-text-color, #0f181f);
  }
  .si-event-divider {
    height: 1px;
    background: #eaeaea;
    margin: 60px auto;
    max-width: 800px;
  }
  @media screen and (max-width: 768px) {
    .si-event-image-row {
      flex-direction: column;
      align-items: center;
    }
    .si-event-image-row img,
    .si-event-image-single img {
      height: auto;
      max-height: 400px;
    }
    .si-event-h1,
    .si-event-h2 {
      font-size: 36px;
    }
  }
</style>

<div class='si-event-upcoming'>
  <div class='si-event-upcoming-inner'>
    <h1 class='si-event-h1'>Where will you find us this year</h1>

    <div class='si-event-date'>AUGUST 9, 2026</div>
    <h2 class='si-event-h2'>Indie Bookworm Event</h2>
    <div class='si-event-subtitle'>Chapter 6 - Book Lovers day</div>

    <div class='si-event-image-row'>
      <img src='{{ 'poster-for-the-Indie.avif' | asset_url }}' alt='Poster for the Indie Bookworm Event' loading='lazy'>
      <img
        src='{{ 'flyer-for-indie-bookworm-event.avif' | asset_url }}'
        alt='Flyer for Indie Bookworm Event'
        loading='lazy'
      >
    </div>

    <p class='si-event-text'>
      Our first family-friendly event celebrating National Book Lovers Day! Meet Jessie Heart and 50+ Australian
      authors.
    </p>
    <p class='si-event-text'>Shelf Indulgence will be there as a Vendor also!</p>
    <p class='si-event-text'>
      Photo booth and face painter included <i><strong>FREE!</strong></i>
    </p>

    <div class='si-event-divider'></div>

    <div class='si-event-date'>AUGUST 29</div>
    <h2 class='si-event-h2'>Romance on The Vines</h2>

    <div class='si-event-image-single'>
      <img src='{{ 'romance-on-the-vines.png' | asset_url }}' alt='Romance on the Vines' loading='lazy'>
    </div>

    <div class='si-event-divider'></div>

    <div class='si-event-date'>NOVEMBER 22, 2026</div>
    <h2 class='si-event-h2'>Bookish Amour</h2>

    <div class='si-event-image-single'>
      <img src='{{ 'event-flyer-for-bookish.avif' | asset_url }}' alt='Event Flyer for Bookish' loading='lazy'>
    </div>

    <div class='si-event-divider'></div>

    <div class='si-event-date'>NOVEMBER 29</div>
    <h2 class='si-event-h2'>Books and Baubles</h2>

    <div class='si-event-image-single'>
      <img src='{{ 'books-and-baubles.png' | asset_url }}' alt='Books and Baubles' loading='lazy'>
    </div>

    <div class='si-event-divider'></div>

    <div class='si-event-date'>FEBRUARY 6, 2027</div>
    <h2 class='si-event-h2'>Unbound Pages</h2>
    <div class='si-event-subtitle'>Canberra</div>

    <div class='si-event-image-single'>
      <img src='{{ 'unbound-pages.png' | asset_url }}' alt='Unbound Pages Canberra' loading='lazy'>
    </div>

    <div class='si-event-divider'></div>

    <div class='si-event-date'>AUGUST 15, 2027</div>
    <h2 class='si-event-h2'>Sweet Love Book Fair</h2>

    <div class='si-event-image-single'>
      <img src='{{ 'sweet-love-book-fair.png' | asset_url }}' alt='Invitation for Sweet Love' loading='lazy'>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SI Event Upcoming",
  "settings": [],
  "presets": [
    {
      "name": "SI Event Upcoming"
    }
  ]
}
{% endschema %}
