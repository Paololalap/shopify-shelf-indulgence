<style>
  .si-coll-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--si-cream-dark)}
  .si-coll-tile{background:var(--si-cream);padding:2.5rem;position:relative;overflow:hidden;transition:background 0.3s;cursor:pointer;text-decoration:none;display:block}
  .si-coll-tile:hover{background:var(--si-burg-faint)}
  .si-coll-tile--alt{background:var(--si-burg-faint)}
  .si-coll-tile-num{font-family:var(--si-serif);font-size:calc(4rem + 10px);color:var(--si-cream-dark);font-weight:300;position:absolute;top:-0.5rem;right:1rem;line-height:1;z-index:0}
  .si-coll-tile-inner{position:relative;z-index:1}
  .si-coll-tile-cat{font-size:calc(0.6rem + 10px);letter-spacing:0.25em;text-transform:uppercase;color:var(--si-gold);margin-bottom:0.6rem;font-weight:400;font-family:var(--si-sans)}
  .si-coll-tile-name{font-family:var(--si-serif);font-size:calc(1.5rem + 10px);color:var(--si-burg-deep);font-weight:400;margin-bottom:0.6rem}
  .si-coll-tile-desc{font-size:calc(0.78rem + 10px);line-height:1.8;color:var(--si-text-mid);font-weight:300;margin-bottom:1.2rem;font-family:var(--si-sans)}
  .si-coll-link{font-size:calc(0.62rem + 10px);letter-spacing:0.2em;text-transform:uppercase;color:var(--si-burg);font-weight:400;display:flex;align-items:center;gap:0.5rem;font-family:var(--si-sans)}
  .si-coll-link-line{width:20px;height:1px;background:var(--si-burg);display:inline-block}
  @media screen and (max-width:749px){.si-coll-grid{grid-template-columns:1fr}}
</style>

<div class="si-coll-grid">
  {% for block in section.blocks %}
    <a href="{{ block.settings.link }}" class="si-coll-tile{% if block.settings.alt_bg %} si-coll-tile--alt{% endif %}" {{ block.shopify_attributes }}>
      <div class="si-coll-tile-num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</div>
      <div class="si-coll-tile-inner">
        <p class="si-coll-tile-cat">{{ block.settings.category }}</p>
        <p class="si-coll-tile-name">{{ block.settings.title }}</p>
        <p class="si-coll-tile-desc">{{ block.settings.description }}</p>
        <p class="si-coll-link"><span class="si-coll-link-line"></span> Shop now</p>
      </div>
    </a>
  {% endfor %}
</div>

{% schema %}
{
  "name": "SI Collections",
  "settings": [],
  "blocks": [
    {
      "type": "tile",
      "name": "Collection Tile",
      "settings": [
        { "type": "text", "id": "category", "label": "Category", "default": "Mystery box" },
        { "type": "text", "id": "title", "label": "Title", "default": "A Novel Encounter" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "A blind date with a book — choose your genre, receive a surprise read plus handpicked bookish goodies." },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "checkbox", "id": "alt_bg", "label": "Alternate background", "default": false }
      ]
    }
  ],
  "presets": [{
    "name": "SI Collections",
    "blocks": [
      { "type": "tile", "settings": { "category": "Mystery box", "title": "A Novel Encounter", "description": "A blind date with a book — choose your genre, receive a surprise read plus handpicked bookish goodies." } },
      { "type": "tile", "settings": { "category": "Curated set", "title": "Ink & Indulgence Box", "description": "A celebration of self-gifting — a book, thematic décor, and soothing self-care items, beautifully presented.", "alt_bg": true } },
      { "type": "tile", "settings": { "category": "Home & décor", "title": "Shelf Décor", "description": "Whimsical, enchanting pieces that make every bookshelf a stunning expression of your unique story.", "alt_bg": true } },
      { "type": "tile", "settings": { "category": "Accessories", "title": "Readers' Guilty Pleasures", "description": "Bookish apparel, hair clips, key rings, and collectibles for the devoted reader in your life." } }
    ]
  }]
}
{% endschema %}
