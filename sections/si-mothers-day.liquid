<style>
  .si-md{
    background: var(--si-cream-warm, #faf7f2);
    padding: 3.5rem 2rem;
    position: relative;
    overflow: hidden;
  }

  .si-md-container {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 4rem;
    position: relative;
    z-index: 2;
  }

  .si-md-image-wrapper {
    flex: 1;
    min-width: 300px;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.08);
  }

  .si-md-image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .si-md-inner{
    flex: 1.2;
    text-align: left;
  }
  .si-md-headline{
    font-family: var(--si-sans, sans-serif);
    font-size: 32px;
    font-weight: 400;
    color: #ec0ac6;
    letter-spacing: 0.04em;
    line-height: 1.5;
    margin: 0 0 1.6rem;
  }
  .si-md-arrival{
    font-family: var(--si-serif, serif);
    font-size: calc(1.6rem + 10px);
    font-weight: 600;
    font-style: italic;
    color: var(--si-burg-deep, #3b1f2b);
    line-height: 1.25;
    margin: 0 0 1.2rem;
  }
  .si-md-divider{
    width: 50px;
    height: 1px;
    background: var(--si-gold, #c5a46d);
    margin: 0 0 1.2rem 0;
  }
  .si-md-body{
    font-family: var(--si-sans, sans-serif);
    font-size: calc(0.78rem + 10px);
    font-weight: 300;
    color: var(--si-text-mid, #7a6e68);
    line-height: 1.85;
    margin: 0 0 2.2rem;
  }
  .si-md-btn{
    display: inline-block;
    background: #ec0ac6;
    color: #fff;
    padding: 0.85rem 2.4rem;
    font-family: var(--si-sans, sans-serif);
    font-size: calc(0.65rem + 10px);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    border: none;
    cursor: pointer;
    font-weight: 400;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }
  .si-md-btn:hover{
    background: #d009b3;
    transform: translateY(-1px);
    box-shadow: 0 4px 20px rgba(236, 10, 198, 0.3);
  }
  /* Decorative petals */
  .si-md-petal{
    position: absolute;
    font-size: 1.4rem;
    opacity: 0.15;
    pointer-events: none;
    animation: si-md-float 6s ease-in-out infinite;
  }
  .si-md-petal:nth-child(1){ top: 12%; left: 8%; animation-delay: 0s; }
  .si-md-petal:nth-child(2){ top: 18%; right: 10%; animation-delay: 1.5s; }
  .si-md-petal:nth-child(3){ bottom: 15%; left: 12%; animation-delay: 3s; }
  .si-md-petal:nth-child(4){ bottom: 20%; right: 8%; animation-delay: 4.5s; }
  @keyframes si-md-float{
    0%,100%{ transform: translateY(0) rotate(0deg); }
    50%{ transform: translateY(-8px) rotate(10deg); }
  }
  @media screen and (max-width: 749px){
    .si-md{ padding: 2.5rem 1.5rem; }
    .si-md-container {
      flex-direction: column;
      gap: 2.5rem;
    }
    .si-md-inner {
      text-align: center;
    }
    .si-md-divider {
      margin: 0 auto 1.2rem auto;
    }
    .si-md-headline{ font-size: 24px; }
    .si-md-arrival{ font-size: calc(1.2rem + 10px); }
  }
</style>

<section class="si-md" id="mothers-day-section">
  <span class="si-md-petal">🌸</span>
  <span class="si-md-petal">🌷</span>
  <span class="si-md-petal">🌸</span>
  <span class="si-md-petal">🌷</span>

  <div class="si-md-container">
    <div class="si-md-image-wrapper">
      <img src="{{ 'holding-tenderness.jpg' | asset_url }}" alt="Mother's Day Special" class="si-md-image" loading="lazy">
    </div>
    <div class="si-md-inner">
      <p class="si-md-headline">{{ section.settings.headline }}</p>
      <h2 class="si-md-arrival">{{ section.settings.subheading }}</h2>
      <div class="si-md-divider"></div>
      <p class="si-md-body">{{ section.settings.body }}</p>
      <a href="{{ section.settings.btn_link }}" class="si-md-btn">{{ section.settings.btn_text }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SI Mothers Day",
  "settings": [
    {
      "type": "html",
      "id": "headline",
      "label": "Headline",
      "default": "🌸 Mother's Day Special: Free Self-Care Gift for Mum with Every Purchase | Limited Quantities Available"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Our limited Mother's Day release has arrived."
    },
    {
      "type": "html",
      "id": "body",
      "label": "Body text",
      "default": "Receive a complimentary self-care gift for Mum with every order. A little something for your reading life… and something lovely for hers."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button text",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button link"
    }
  ],
  "presets": [{ "name": "SI Mothers Day" }]
}
{% endschema %}
