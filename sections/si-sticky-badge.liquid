<style>
  .si-sticky-badge-wrapper {
    position: fixed;
    bottom: 30px;
    left: 30px;
    z-index: 9999;
    pointer-events: auto;
  }

  .si-sticky-badge {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 75px;
    height: 75px;
    background-color: #ec0ac6;
    color: #ffffff;
    border-radius: 50%;
    text-decoration: none;
    box-shadow: 0 8px 20px rgba(236, 10, 198, 0.4);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    border: 1.5px solid #ffffff;
    padding: 8px;
    text-align: center;
    overflow: hidden;
  }

  .si-sticky-badge:hover {
    transform: translateY(-5px) scale(1.1);
    box-shadow: 0 12px 30px rgba(236, 10, 198, 0.6);
    background-color: #f50bd0;
  }

  .si-sticky-badge-text {
    font-family: var(--si-sans, sans-serif);
    font-size: 7.5px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1.2;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  @media screen and (max-width: 749px) {
    .si-sticky-badge-wrapper {
      bottom: 25px;
      left: 20px;
    }
    .si-sticky-badge {
      width: 65px;
      height: 65px;
      padding: 6px;
    }
    .si-sticky-badge-text {
      font-size: 6.5px;
    }
  }
</style>

<div class="si-sticky-badge-wrapper">
  <a href="{{ section.settings.link | default: routes.all_products_collection_url }}" class="si-sticky-badge">
    <div class="si-sticky-badge-text">
      {% assign words = section.settings.label | split: ' ' %}
      {% for word in words %}
        <span>{{ word }}</span>
      {% endfor %}
    </div>
  </a>
</div>

{% schema %}
{
  "name": "SI Sticky Badge",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "FREE MOTHER’S DAY GIFT ON EVERY PURCHASE"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "SI Sticky Badge"
    }
  ]
}
{% endschema %}
